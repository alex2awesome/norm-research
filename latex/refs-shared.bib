@article{hirschauer2015how,
  author  = {Hirschauer, Stefan},
  title   = {How Editors Decide: Oral Communication in Journal Peer Review},
  journal = {Human Studies},
  volume  = {38},
  number  = {1},
  pages   = {37--55},
  year    = {2015},
  keywords = {domain=peer-review; gap=felt-not-stated; type=ethnography},
  annote  = {VERIFIED 2026-07-28 (full PDF recovered from a crashed retrieval agent's downloads
             and read locally with pdftotext -layout; Springer running head confirms
             Hum Stud (2015) 38:37--55. PAGE NUMBERS NOT RESOLVED -- the extracted footers carry
             Springer's "123" mark, not printed folios, so cite by section until a paginated
             copy is checked. Do not invent a folio.)
             Abstract, now verified rather than second-hand: "The operative nucleus of peer
             review processes has largely remained a `black box' to analytical empirical
             research."
             THE PAYLOAD -- Hirschauer's three-phase model of an editor's judgment, stated in
             his own words (section "Before focusing the oral communication on editors'
             meetings...", and cited there to Hirschauer 2010): "(1) There is a pre-formed
             judgment -- the preset attitude that readers have toward all texts which `exists'
             before reading... (2) In the second phase, a judgment is a spontaneous impression
             developed over the course of reading a manuscript and negotiating with it. It is
             about what you observed in and understood of a text. (3) The third phase is the
             written judgment or statement that is enunciated in the post hoc reasoning about
             the text. It is produced in the public sphere of boards, and it is about the
             position that one can defend in an argument."
             Then the line to quote: "So there are always tendentious, spontaneous, and
             rationalizing aspects in an individual statement to publish or not. THIS IS KNOWN
             TO ALL PARTICIPANTS IN PEER REVIEW." (emphasis added) -- i.e. the written reasons
             are openly understood by the participants to be post-hoc defensible positions, not
             the judgment itself. Structurally identical to hutcheson1929judgment's claim about
             judicial opinions, arrived at ethnographically rather than confessionally.
             BONUS, and directly relevant to comparative-judgment designs: standards are
             pool-relative because the issue must be filled -- "they have to be flexibly
             applied, since there is no vacancy option. Quality claims cannot simply be upheld
             against the offer on hand, they have to be displayed with it."}
}

