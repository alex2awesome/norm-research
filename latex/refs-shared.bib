@article{naur1985programming,
  author  = {Naur, Peter},
  title   = {Programming as Theory Building},
  journal = {Microprocessing and Microprogramming},
  volume  = {15},
  number  = {5},
  pages   = {253--261},
  year    = {1985},
  note    = {Reprinted in Naur, \emph{Computing: A Human Activity} (1992)},
  keywords = {domain=coding; gap=felt-not-stated; type=essay},
  annote  = {VERIFIED (gwern.net mirror with a working text layer; the common
             pages.cs.wisc.edu mirror is an unreadable scan). The central claim:
             "The dependence of a theory on a grasp of certain kinds of similarity between
             situations and events of the real world gives the reason why the knowledge held
             by someone who has the theory could not, in principle, be expressed in terms of
             rules." And: "the similarities in question are not, and cannot be, expressed in
             terms of criteria, no more than the similarities of many other kinds of objects,
             such as human faces, tunes, or tastes of wine, can be thus expressed."
             Supporting case: a "highly motivated" receiving team with full documentation
             could not extend a program in keeping with its design, while the original team
             could "spot these cases instantly." This is the strongest in-principle
             articulation-gap claim in the software literature.}
}

