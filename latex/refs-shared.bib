@book{gans1979deciding,
  author    = {Gans, Herbert J.},
  title     = {Deciding What's News: A Study of {CBS} Evening News, {NBC} Nightly News, Newsweek, and Time},
  publisher = {Pantheon Books},
  year      = {1979},
  keywords  = {domain=journalism; gap=felt-not-stated; type=ethnography},
  annote    = {SNIPPET (via De Maeyer 2020, whose full text was fetched at
               sociologica.unibo.it and confirmed to quote Gans verbatim with page
               cites). "news judgment is 'partly a matter of feel'" (p. 171);
               journalists "act on the basis of quick, virtually intuitive judgments,
               which some ascribe to 'feel'" (p. 82). Why it matters: Gans is normally
               read as THE explicit-considerations taxonomy of news selection, which
               makes his own concession that the underlying judgment is felt unusually
               load-bearing. Primary book not fetched; pull the two pages before camera copy.}
}

@book{epstein1973news,
  author    = {Epstein, Edward Jay},
  title     = {News from Nowhere: Television and the News},
  publisher = {Random House},
  year      = {1973},
  keywords  = {domain=journalism; gap=criteria-underdet; type=ethnography},
  annote    = {VERIFIED (full book OCR'd from
               worldradiohistory.com/BOOKSHELF-ARH/News/News-From-Nowhere-Epstein-1973.pdf).
               "the producers' unwritten but generally known preferences for certain
               types of stories are of much more importance to correspondents" (pp. 168--169).
               On the correspondent blacklist: reasons "varied, according to executive
               producers' offhanded descriptions, from their age ('too old') to their
               general appearance ('lack of sex appeal') to their presentation ('not
               punchy enough' or 'no sense of humor')" (p. 189). And, on refusing outside
               scrutiny: "Salant said that he would refuse to answer any questions about
               news judgments" (p. 10). Why it matters: criteria that demonstrably exist
               and produce consistent outcomes, are explicitly unwritten, and that
               executives decline to make explicit even when asked.}
}

