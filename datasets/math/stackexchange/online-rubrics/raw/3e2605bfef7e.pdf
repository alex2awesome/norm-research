/* Schrift */

@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Display:ital,wght@0,100..900;1,100..900&display=swap');


body, a, span, div, ul, ol, li, td, th, form, fieldset, input, button, select, textarea, p {
	font-family: "Noto Sans Display", sans-serif;
  font-weight: 300;
  font-style: normal;
}

/* Schrift end */

#header-meta {
  border-bottom: 0px solid;
}

#header-meta .small-info-text{
		background-image: url(/wp-content/uploads/2025/07/logo-head.png);
	background-repeat: no-repeat;
	background-size: 50px auto;
	background-position: center left;
	padding: 15px 70px;
}

#site-description a{
	color: #fff;
}

#header-meta .small-info-text a p:hover,
#site-description a:hover{
	color: #D64265;
}


.main-navigation {
  padding-top: 0px;
}

.fa-caret-right::before {
  color: #fff;
}

#header-text-nav-container .bottom-menu .inner-wrap{
	border-top: 1px solid rgba(255, 255, 255, 0.25);
}

#header-text-nav-container .bottom-menu .inner-wrap .nav-menu a{
	font-size: 18px;
  line-height: 18px;
	padding: 10px;
}

#header-text-nav-container .bottom-menu .inner-wrap .nav-menu .current_page_item {
	background: #fff;
}
#header-text-nav-container .bottom-menu .inner-wrap .nav-menu .current_page_item a{
		color: #00305B;
}
#header-text-nav-container .bottom-menu .inner-wrap .nav-menu a:hover{
		color: #00305B;
}

.main-navigation ul li ul {
  width: 250px;
}
.main-navigation ul.sub-menu li a{
	font-size: 14px !important;
}
.current_page_item .fa-caret-right::before,
.current_page_item .fa-caret-down::before {
  color: rgb(214,66,101);
}





#main {
  padding: 0px 0 10px 0;
	 background-image: url('/wp-content/uploads/2025/07/Siegel-hell_Universitaet-Marburg-hell2.png');
  background-attachment: fixed;
  background-position: center center;
  background-size: cover;
 }

.box-blau{
	background-color:#6689e3;
	color: #fff;
}
.box-blau a{
	background-color:#6689e3;
	color: rgb(0,48,91);
}

hr {
  background-color: #666;
  height: 2px;
}


.header-post-title-container {
  border-bottom: 0px solid #EAEAEA;
  padding: 20px 0;
	background: transparent;
  box-shadow: none;
}

body.page .header-post-title-container{
	display:none;
}

/* Footer */
.copyright p{
	color: #fff;
}

#menu-footer li a{
	font-size: 16px;
}



#post-371 a.geomReihe,
#post-371 a.geomReihe:hover{
	text-decoration: none !important;
}


/* Responsive */
@media (max-width: 1070px) {
  #header-text-nav-container .bottom-menu .inner-wrap .nav-menu a {
		font-size: 16px;
		line-height: 16px;
		padding: 5px;
  }
}
@media (max-width: 900px) {
  #header-text-nav-container .bottom-menu .inner-wrap .nav-menu a {
		font-size: 14px;
		line-height: 14px;
		padding: 3px;
  }
}
@media (max-width: 788px) {
  #header-text-nav-container .bottom-menu .inner-wrap .nav-menu a {
		font-size: 12px;
		line-height: 12px;
		padding: 10px;
  }
	
	#menu-main li ul li{
		padding: 10px 10px 10px 20px;
	}
	
	#header-text-nav-container .bottom-menu .inner-wrap .nav-menu .current_page_item .sub-menu a {
  color: #fff;
}
.main-small-navigation ul > .current_page_item, .main-small-navigation ul > .current-menu-ancestor, .main-small-navigation ul > .current-menu-item {
  background: #666;
}
}

/* --- StuKon anpassung --- */

.page-id-945 #header-text #site-title{
	display: none;
}

.page-id-945 #header-text #site-description{
	padding-top: 36px;
}

.page-id-945 #header-text #site-description a{
	font-size: 180%;
	font-weight: 500 !important;
}

.page-id-945 .bottom-menu{
	display: none;
}


/* --- UNCUMR anpassung --- */

.page-id-992 #header-text #site-title{
