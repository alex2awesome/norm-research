thanks_received": 1, "thankers": "Adventure10, Mango247", "deleted": false, "post_number": 2, "post_time": 1345887561, "num_edits": 1, "post_format": "bbcode", "last_edit_time": 1345892945, "last_editor_username": "roza2010", "last_edit_reason": "", "admin": false, "is_auto_flagged": false, "avatar": "//avatar.artofproblemsolving.com/avatar_86443.jpg", "num_posts": 2877, "editable": false, "deletable": false, "show_from_start": true, "show_from_end": true}, {"post_id": 2782701, "topic_id": 495607, "poster_id": 135501, "post_rendered": "\n<div class=\"bbcode_quote\">\n<div class=\"bbcode_quote_head\">roza2010 wrote:</div>\n<div class=\"bbcode_quote_body\">only solution <img src=\"//latex.artofproblemsolving.com/a/e/7/ae7a465ffe5255961382f5777569608be052b783.png\" class=\"latex\" alt=\"$(1,1)$\" style=\"vertical-align: -4px\" width=\"38\" height=\"18\" ></div>\n</div>\nhow come ?", "post_canonical": "[quote=\"roza2010\"]only solution $(1,1)$[/quote]\nhow come ?", "username": "Pheonix", "reported": false, "is_thanked": false, "is_nothanked": false, "attachment": false, "thanks_received": 2, "nothanks_received": 0, "thankers": "Adventure10, Mango247", "deleted": false, "post_number": 3, "post_time": 1345891404, "num_edits": 0, "post_format": "bbcode", "last_edit_time": 0, "last_editor_username": "", "last_edit_reason": "", "admin": false, "is_auto_flagged": false, "avatar": "//avatar.artofproblemsolving.com/avatar_135501.jpg", "num_posts": 538, "editable": false, "deletable": false, "show_from_start": true, "show_from_end": true}, {"post_id": 2782707, "topic_id": 495607, "poster_id": 64716, "post_rendered": "The multiplicative order of <img src=\"//latex.artofproblemsolving.com/4/1/c/41c544263a265ff15498ee45f7392c5f86c6d151.png\" class=\"latex\" alt=\"$2$\"  width=\"8\" height=\"12\" > modulo <img src=\"//latex.artofproblemsolving.com/b/7/6/b7616a230c77f0d9a577e5bca01aa06f1c35c457.png\" class=\"latex\" alt=\"$17$\" style=\"vertical-align: 0px\" width=\"18\" height=\"12\" > is <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/8/4/5/8455f3b5cb3b4880b8c9d782a5c1f0334db819eb.png\" class=\"latex\" alt=\"$8$\"  width=\"8\" height=\"12\" >,</span> since <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/1/7/2/172c5da456e9387b98b149d44664d24c527a3f0f.png\" class=\"latex\" alt=\"$2^4 = 16 \\equiv -1 \\pmod{17}$\" style=\"vertical-align: -4px\" width=\"186\" height=\"19\" >.</span> Therefore, if <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/5/4/d/54dcc403405dfb565d57d1d25afa13cd6bffc603.png\" class=\"latex\" alt=\"$x\\geq 3$\" style=\"vertical-align: -2px\" width=\"43\" height=\"15\" >,</span> then <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/0/4/7/047a331ac1c9a4d474c58c17e505f63ab40cc43c.png\" class=\"latex\" alt=\"$8 \\mid 2^x$\" style=\"vertical-align: -4px\" width=\"40\" height=\"18\" >,</span> and so <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/a/a/9/aa9a5326b4fa15193e6687a46df5b4a79e2838d6.png\" class=\"latex\" alt=\"$2^{2^x} \\equiv 1 \\pmod{17}$\" style=\"vertical-align: -4px\" width=\"137\" height=\"20\" >.</span> So <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/e/0/a/e0a299ac190592a5e56d3b5e89f9f2e23c222a41.png\" class=\"latex\" alt=\"$x\\leq 2$\" style=\"vertical-align: -2px\" width=\"43\" height=\"14\" >,</span> and so the only solution is <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/7/1/f/71fcccde44c0dc646d9e21acf5c1024a2925b914.png\" class=\"latex\" alt=\"$(x,y) = (2,1)$\" style=\"vertical-align: -4px\" width=\"105\" height=\"18\" >.</span>", "post_canonical": "The multiplicative order of $2$ modulo $17$ is $8$, since $2^4 = 16 \\equiv -1 \\pmod{17}$. Therefore, if $x\\geq 3$, then $8 \\mid 2^x$, and so $2^{2^x} \\equiv 1 \\pmod{17}$. So $x\\leq 2$, and so the only solution is $(x,y) = (2,1)$.", "username": "mavropnevma", "reported": false, "is_thanked": false, "is_nothanked": false, "attachment": false, "thanks_received": 2, "nothanks_received": 0, "thankers": "Adventure10, Mango247", "deleted": false, "post_number": 4, "post_time": 1345892209, "num_edits": 0, "post_format": "bbcode", "last_edit_time": 0, "last_editor_username": "", "last_edit_reason": "", "admin": false, "is_auto_flagged": false, "avatar": "//avatar.artofproblemsolving.com/avatar_64716.png", "num_posts": 15142, "editable": false, "deletable": false, "show_from_start": true, "show_from_end": true}], "tags": [{"tag_id": 178, "tag_text": "modular arithmetic", "is_public": true, "is_visible": true}], "data_to_set_direct_on_topic": {"last_post_time": 1345892209, "last_poster_name": "mavropnevma", "num_posts": 4, "last_update_time": 1724506174, "locked": false, "num_views": 90}, "time_in_script": 29.38699722290039, "cmty_status": "active", "user_session_data": {"user_id": 1, "username": "Anonymous", "logged_in": false, "initialized": false, "logged_in_and_initialized": false}}}