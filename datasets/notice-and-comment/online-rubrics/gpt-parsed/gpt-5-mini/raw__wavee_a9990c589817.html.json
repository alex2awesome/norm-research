      {
        "name": "\uc785\ubc95\uc548\uc758 \uae30\uc7ac \ub0b4\uc6a9(\uacf5\uace0 \ud560 \ub0b4\uc6a9)",
        "description": "\uc81c\uc815 \ub610\ub294 \uac1c\uc815\ud558\uace0\uc790 \ud558\ub294 \ubc95\ub839\uc548\uc758 \uc785\ubc95\ucde8\uc9c0\uc640 \uc8fc\uc694\ub0b4\uc6a9\uc744 \uc8fc\uad00\ubd80\uc11c\uc758 \uc7a5(\u9577)\uc774 \ud56d\ubaa9\ubcc4\ub85c \uad00\ubcf4 \ub610\ub294 \uc77c\ubc18\uc2e0\ubb38\uc5d0 \uac8c\uc7ac\ud558\uc5ec \uc608\uace0\ud55c\ub2e4.",
        "guidance": "\uacf5\uace0\ubb38\uc5d0\ub294 \uc785\ubc95\ucde8\uc9c0\uc640 \uc8fc\uc694\ub0b4\uc6a9\uc744 \ud56d\ubaa9\ubcc4\ub85c \uba85\ud655\ud788 \uae30\uc7ac\ud574\uc57c \ud558\uba70, \uc8fc\uad00\ubd80\uc11c\uc7a5\uc774 \ucc45\uc784\uc744 \uc9c0\uace0 \uad00\ubcf4\ub098 \uc77c\ubc18\uc2e0\ubb38 \ub4f1\uc5d0 \uac8c\uc7ac\ud558\uc5ec \uc608\uace0\ud558\ub3c4\ub85d \ub418\uc5b4 \uc788\ub2e4(\ub0b4\uc6a9\uc758 \uad6c\uccb4\uc131\u00b7\uba85\uc2dc\uc131\uc774 \uc694\uad6c\ub428)."
      },
      {
        "name": "\uc758\uacac \uc81c\ucd9c \uac00\ub2a5\uc790",
        "description": "\ub204\uad6c\ub4e0\uc9c0 \uc608\uace0\ub41c \uc785\ubc95\uc548\uc5d0 \ub300\ud558\uc5ec \uadf8 \uc758\uacac\uc744 \uc81c\ucd9c\ud560 \uc218 \uc788\ub2e4[6].",
        "guidance": "\uc785\ubc95\uc608\uace0 \uc81c\ub3c4\ub294 \uc5f4\ub824\uc788\ub294 \ucc38\uc5ec\ub97c \uc804\uc81c\ub85c \ud558\ubbc0\ub85c \uac1c\uc778\u00b7\ub2e8\uccb4 \uad6c\ubd84 \uc5c6\uc774 \ubaa8\ub4e0 \uad6d\ubbfc\uc774 \uc758\uacac\uc744 \uc81c\ucd9c\ud560 \uc218 \uc788\ub2e4."
      },
      {
        "name": "\uc758\uacac\uc811\uc218 \uad00\ub828 \uacf5\uace0\uc758\ubb34",
        "description": "\ud589\uc815\uccad\uc740 \uc758\uacac\uc811\uc218\uae30\uac04, \uc758\uacac\uc81c\ucd9c\uae30\uad00 \uae30\ud0c0 \ud544\uc694\ud55c \uc0ac\ud56d\uc744 \ub2f9\ud574 \uc785\ubc95\uc548\uc744 \uc608\uace0\ud560 \ub54c \ud568\uaed8 \uacf5\uace0\ud558\uc5ec\uc57c \ud55c\ub2e4[7].",
        "guidance": "\uc785\ubc95\uc548 \uacf5\uace0 \uc2dc \uc758\uacac \uc81c\ucd9c\uc744 \uc704\ud55c \uc2e4\ubb34\uc801 \uc815\ubcf4(\uc811\uc218\uae30\uac04\u00b7\uc81c\ucd9c\uae30\uad00\u00b7\uc81c\ucd9c\ubc29\ubc95 \ub4f1)\ub97c \ud568\uaed8 \uacf5\uc9c0\ud574\uc57c \ud558\uba70, \uc774\ub294 \ucc38\uc5ec \uc811\uadfc\uc131\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uc758\ubb34\uc774\ub2e4."
      },
      {
        "name": "\uacf5\uccad\ud68c \uac1c\ucd5c \uc5ec\ubd80",
        "description": "\ud589\uc815\uccad\uc740 \uc785\ubc95\uc548\uc5d0 \ub300\ud558\uc5ec \uacf5\uccad\ud68c\ub97c \uac1c\ucd5c\ud560 \uc218 \uc788\ub2e4[8].",
        "guidance": "\uacf5\uccad\ud68c\ub294 \ud589\uc815\uccad\uc774 \ud544\uc694\ud558\ub2e4\uace0 \ud310\ub2e8\ud560 \uacbd\uc6b0 \uac1c\ucd5c\ud560 \uc218 \uc788\ub294 \uacf5\uac1c\uc801 \uc758\uacac\uc218\ub834 \uc218\ub2e8\uc73c\ub85c, \ubc95\uc801\uc73c\ub85c \uc758\ubb34\uac00 \uc544\ub2cc \uc7ac\ub7c9\uc0ac\ud56d\uc784\uc744 \uba85\uc2dc\ud55c\ub2e4."
      },
      {
        "name": "\uc81c\ucd9c\uc758\uacac\uc758 \ucc98\ub9ac\u00b7\uc874\uc911 \uc758\ubb34",
        "description": "\ud589\uc815\uccad\uc740 \ub2f9\ud574 \uc785\ubc95\uc548\uc5d0 \ub300\ud55c \uc758\uacac\uc774 \uc81c\ucd9c\ub41c \uacbd\uc6b0 \ud2b9\ubcc4\ud55c \uc0ac\uc720\uac00 \uc5c6\ub294 \ud55c \uc774\ub97c \uc874\uc911\ud558\uc5ec \ucc98\ub9ac\ud558\uc5ec\uc57c \ud55c\ub2e4[9].",
        "guidance": "\ud589\uc815\uccad\uc740 \uc81c\ucd9c\ub41c \uc758\uacac\uc744 \ub2e8\uc21c\ud788 \uc218\uc9d1\ud558\ub294 \ub370 \uadf8\uce58\uc9c0 \uc54a\uace0, \ud2b9\ubcc4\ud55c \uc0ac\uc720\uac00 \uc5c6\ub294 \ud55c \uc874\uc911\ud558\uace0 \ucc98\ub9ac\ud558\ub294 \uc758\ubb34\uac00 \uc788\uc73c\uba70 \uc774\ub294 \uc785\ubc95\uc608\uace0 \uc81c\ub3c4\uc758 \ud575\uc2ec\uc778 \uc758\uacac \ubc18\uc601 \ucc45\uc784\uc744 \ub73b\ud55c\ub2e4."
      },
      {
        "name": "\uc758\uacac \uc81c\ucd9c\uc790\uc5d0 \ub300\ud55c \ucc98\ub9ac\uacb0\uacfc \ud1b5\uc9c0 \uc758\ubb34",
        "description": "\ud589\uc815\uccad\uc740 \uc758\uacac\uc744 \uc81c\ucd9c\ud55c \uc790\uc5d0\uac8c \uadf8 \uc81c\ucd9c\ub41c \uc758\uacac\uc758 \ucc98\ub9ac\uacb0\uacfc\ub97c \ud1b5\uc9c0\ud558\uc5ec\uc57c \ud55c\ub2e4[10].",
        "guidance": "\uc758\uacac \uc81c\ucd9c\uc790\uc5d0\uac8c \ucc98\ub9ac\uacb0\uacfc\ub97c \ud1b5\uc9c0\ud568\uc73c\ub85c\uc368 \uc758\uacac\uc81c\ucd9c\uc774 \ub2e8\uc808\ub418\uc9c0 \uc54a\ub3c4\ub85d \ud558\uace0 \ud589\uc815\uc758 \ucc45\uc784\uc131\uacfc \ud22c\uba85\uc131\uc744 \ud655\ubcf4\ud574\uc57c \ud55c\ub2e4."
      },
      {
        "name": "\ubc95\uc801 \uadfc\uac70 \ubc0f \uad00\ub828 \uaddc\uc815",
        "description": "\uc785\ubc95\uc608\uace0\uc5d0 \ub300\ud574\uc11c\ub294 \ub300\ud55c\ubbfc\uad6d \ud589\uc815\uc808\ucc28\ubc95 \ubc0f \ubc95\uc81c \uc5c5\ubb34\uc6b4\uc601\uaddc\uc815 \ub4f1\uc5d0\uc11c \uadfc\uac70\uc640 \ubc29\ubc95\uc744 \uaddc\uc815\ud558\uace0 \uc788\ub2e4 (\ubcf8\ubb38\uc5d0 \ud589\uc815\uc808\ucc28\ubc95 \uc81c42\uc870 \uc81c1\ud56d\u00b7\uc81c43\uc870\u00b7\uc81c44\uc870\u00b7\uc81c45\uc870 \ub4f1 \uc778\uc6a9).",
        "guidance": "\uc2e4\ubb34 \uc801\uc6a9 \uc2dc \ud574\ub2f9 \uc870\ubb38\uacfc \uc2dc\ud589\uaddc\uce59\u00b7\uc5c5\ubb34\uc6b4\uc601\uaddc\uc815\uc758 \uad6c\uccb4\uc801 \uaddc\uc815(\uc608: \uc608\uace0 \ubc29\ubc95\u00b7\uae30\uac04\u00b7\uc808\ucc28 \ub4f1)\uc744 \ud655\uc778\ud574\uc57c \ud55c\ub2e4."
