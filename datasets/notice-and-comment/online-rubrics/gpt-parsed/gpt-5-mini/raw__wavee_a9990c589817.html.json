    "error": null,
    "rubrics_metrics": [
      {
        "name": "\uc785\ubc95\uc608\uace0\uc758 \uc815\uc758",
        "description": "\uc785\ubc95\uc608\uace0(\u7acb\u6cd5\u8c6b\u544a)\ub780 \uad6d\ubbfc\uc758 \uad8c\ub9ac, \uc758\ubb34 \ub610\ub294 \uc77c\uc0c1\uc0dd\ud65c\uacfc \ubc00\uc811\ud55c \uad00\ub828\uc774 \uc788\ub294 \ubc95\ub839\ub4f1\uc744 \uc81c\uc815, \uac1c\uc815 \ub610\ub294 \ud3d0\uc9c0\ud558\uace0\uc790 \ud560 \ub54c\uc5d0\ub294 \ub2f9\ud574 \uc785\ubc95\uc548\uc744 \ub9c8\ub828\ud55c \ud589\uc815\uccad\uc774 \uc774\ub97c \uc608\uace0\ud558\ub294 \uac83\uc744 \ub9d0\ud55c\ub2e4[1].",
        "guidance": "\uc785\ubc95\uc608\uace0\ub294 \uad6d\ubbfc\uc758 \uc785\ubc95 \ucc38\uc5ec \uae30\ud68c\ub97c \ud655\ub300\ud558\uc5ec \uc785\ubc95\uc758 \ubbfc\uc8fc\ud654\ub97c \uae30\ud558\uace0 \ubc95\ub839\uc758 \uc2e4\ud6a8\uc131\uc744 \ub192\uc5ec \uad6d\uac00 \uc815\ucc45\uc218\ud589\uc758 \ud6a8\uc728\ud654\ub97c \ub3c4\ubaa8\ud558\ub294 \uc81c\ub3c4\uc774\ub2e4. (\ubcf8\ubb38: '\uad6d\ubbfc\uc758 \uc77c\uc0c1\uc0dd\ud65c\uacfc \uc9c1\uc811 \uad00\ub828\ub418\ub294 \ubc95\ub839\uc548\uc758 \ub0b4\uc6a9\uc744 \uc785\ubc95\uc5d0 \uc55e\uc11c \uad6d\ubbfc\uc5d0\uac8c \uc608\uace0\ud568\uc73c\ub85c\uc368 \uad6d\ubbfc\uc758 \uc785\ubc95 \ucc38\uc5ec \uae30\ud68c\ub97c \ud655\ub300\ud558\uc5ec \uc785\ubc95\uc758 \ubbfc\uc8fc\ud654\ub97c \uae30\ud558\uace0 \ubc95\ub839\uc758 \uc2e4\ud6a8\uc131\uc744 \ub192\uc5ec \uad6d\uac00 \uc815\ucc45\uc218\ud589\uc758 \ud6a8\uc728\ud654\ub97c \ub3c4\ubaa8\ud558\ub294 \uc81c\ub3c4\uc774\ub2e4.')"
      },
      {
        "name": "\ubc95\uc81c\uccad\uc758 \uad8c\uace0 \ub610\ub294 \uc9c1\uc811 \uc608\uace0 \uad8c\ud55c",
        "description": "\uad00\ub828 \ud589\uc815\uccad\uc774 \uc785\ubc95\uc608\uace0\ub97c \ud558\uc9c0 \uc54a\uc740 \uac83\uc774 \ubd80\uc801\ub2f9\ud558\ub2e4\uace0 \ud310\ub2e8\ub420 \ub54c\uc5d0\ub294 \ubc95\uc81c\uccad\uc7a5\uc774 \ud589\uc815\uccad\uc5d0 \ub300\ud574 \uc785\ubc95\uc608\uace0\ub97c \uad8c\uace0\ud558\uac70\ub098 \uc9c1\uc811 \uc608\uace0\ud560 \uc218 \uc788\uace0 \uc785\ubc95\uc608\uace0\uc758 \ubc29\ubc95\uc5d0 \ub300\ud574\uc11c\ub294 \ubc95\uc81c \uc5c5\ubb34\uc6b4\uc601\uaddc\uc815 \uc81c15\uc870\uc5d0\uc11c \uaddc\uc815\ud55c\ub2e4[2].",
        "guidance": "\ubc95\uc81c\uccad\uc740 \ud589\uc815\uccad\uc758 \ubbf8\uc2e4\uc2dc \uc2dc \uad8c\uace0\ud558\uac70\ub098 \uc9c1\uc811 \uc608\uace0\ud560 \uc218 \uc788\ub294 \uac10\ub3c5\u00b7\uac1c\uc785 \uad8c\ud55c\uc744 \uac00\uc9c4\ub2e4(\ubc95\uc801\u00b7\uc6b4\uc601\uaddc\uc815\uc0c1\uc758 \uadfc\uac70)."
      },
      {
        "name": "\uc785\ubc95\uc608\uace0\uc758 \ubc29\ubc95 (\uacf5\uace0 \ubc29\uc2dd)",
        "description": "\ud589\uc815\uccad\uc740 \uc785\ubc95\uc548\uc758 \ucde8\uc9c0, \uc8fc\uc694\ub0b4\uc6a9 \ub610\ub294 \uc804\ubb38\uc744 \uad00\ubcf4, \uacf5\ubcf4\ub098 \uc778\ud130\ub137 \uc2e0\ubb38, \ubc29\uc1a1 \ub4f1\uc758 \ubc29\ubc95\uc73c\ub85c \ub110\ub9ac \uacf5\uace0\ud558\uc5ec\uc57c \ud55c\ub2e4[4].",
        "guidance": "\uacf5\uace0\ubc29\ubc95\uc73c\ub85c \uad00\ubcf4\u00b7\uacf5\ubcf4\u00b7\uc778\ud130\ub137 \uc2e0\ubb38\u00b7\ubc29\uc1a1 \ub4f1 \ub2e4\uc591\ud55c \ub9e4\uccb4\ub97c \ud65c\uc6a9\ud558\uc5ec \ub110\ub9ac \uc54c\ub9ac\ub3c4\ub85d \uaddc\uc815\ub418\uc5b4 \uc788\ub2e4. \uc989, \ub2e8\uc21c \uac8c\uc7ac\uac00 \uc544\ub2c8\ub77c \uad11\ubc94\uc704\ud55c \ud64d\ubcf4\u00b7\uacf5\ud45c \uc758\ubb34\uac00 \ud3ec\ud568\ub41c\ub2e4."
      },
      {
        "name": "\uc785\ubc95\uc608\uace0 \uae30\uac04(\uae30\ubcf8 \uc6d0\uce59)",
        "description": "\uc785\ubc95\uc608\uace0 \uae30\uac04\uc740 \uc608\uace0\uc2dc\uc5d0 \uc815\ud558\ub098 \ud2b9\ubcc4\ud55c \uc0ac\uc815\uc774 \uc5c6\ub294 \ud55c 20\uc77c \uc774\uc0c1\uc774 \uc77c\ubc18\uc801\uc774\ub2e4[3].",
        "guidance": "\uc785\ubc95\uc548 \ubc1c\ud45c \uc2dc \uae30\uac04\uc744 \uba85\uc2dc\ud558\ub418, \ud2b9\ubcc4\ud55c \uc0ac\uc815\uc774 \uc5c6\ub294 \ud55c \uc77c\uc815 \uae30\uac04(\ubcf8\ubb38 \uae30\ub85d\uc0c1 '20\uc77c \uc774\uc0c1')\uc744 \ud655\ubcf4\ud558\ub294 \uac83\uc774 \uc77c\ubc18\uc801\uc774\ub2e4. (\ubcf8\ubb38\uc5d0 \ub2e4\ub978 \uc870\ubb38\uc5d0 \ub530\ub77c '40\uc77c \uc774\uc0c1' \uaddc\uc815\ub3c4 \ubcd1\uae30\ub418\uc5b4 \uc788\uc5b4 \uc608\uace0\uae30\uac04\uc740 \ubc95\ub839\u00b7\uc2dc\ud589\uaddc\uce59\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc74c.)"
      },
      {
        "name": "\uc785\ubc95\uc608\uace0 \uae30\uac04(\ud589\uc815\uc808\ucc28\ubc95 \uae30\uc900)",
        "description": "\uc785\ubc95\uc608\uace0\uae30\uac04\uc740 \uc608\uace0\ub97c \ud560 \ub54c \uc815\ud558\ub418, \ud2b9\ubcc4\ud55c \uc0ac\uc815\uc774 \uc5c6\ub294 \ud55c 40\uc77c \uc774\uc0c1\uc73c\ub85c \ud55c\ub2e4[5].",
        "guidance": "\ubcf8\ubb38\uc740 \ub450 \ubb38\uad6c\ub97c \ubcd1\uae30\ud558\uace0 \uc788\uc5b4 \uc2e4\ubb34\uc0c1 \uc801\uc6a9\ub418\ub294 \uad6c\uccb4\uc801 \uae30\uac04\uc740 \uad00\ub828 \ubc95\ub839\uc870\ud56d(\uc608: \ud589\uc815\uc808\ucc28\ubc95 \uc81c43\uc870 \ub4f1)\uc5d0 \ub530\ub978\ub2e4. \uc608\uc678 \uc0ac\uc720\uac00 \uc788\uc74c\uc744 \uba85\uc2dc\ud568."
