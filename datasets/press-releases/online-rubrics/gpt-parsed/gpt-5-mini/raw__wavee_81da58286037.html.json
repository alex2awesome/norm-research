      {
        "name": "When to hold a press conference and managing press Q&A risks",
        "description": "\u8a18\u8005\u4f1a\u898b\u306f\u5927\u304d\u306a\u7d44\u7e54\u3084\u653f\u5e9c\u6a5f\u95a2\u304c\u793e\u4f1a\u7684\u306b\u898b\u3066\u304b\u306a\u308a\u91cd\u8981\u306a\u5185\u5bb9\u306e\u767a\u8868\u3092\u3059\u308b\u3068\u304d\u306b\u958b\u304f\u3002\u8a18\u8005\u4f1a\u898b\u4e2d\u306b\u767a\u8a00\u5185\u5bb9\u306b\u4e0d\u6b63\u78ba\u30fb\u4e0d\u7528\u610f\u306a\u767a\u8a00\u3092\u3059\u308b\u3068\u3001\u53d6\u308a\u8fd4\u3057\u306e\u3064\u304b\u306a\u3044\u3053\u3068\u306b\u306a\u308a\u5f97\u308b\u3002\u307e\u305f\u3001\u8a18\u8005\u4f1a\u898b\u4e2d\u306b\u4e8b\u4ef6\u304c\u8d77\u304d\u308b\u3068\u3001\u809d\u5fc3\u306e\u30d7\u30ec\u30b9\u30ea\u30ea\u30fc\u30b9\u306e\u5185\u5bb9\u81ea\u4f53\u304c\u30e1\u30c7\u30a3\u30a2\u306b\u306e\u3089\u306a\u304f\u306a\u308b\u3053\u3068\u304c\u3042\u308b\u3002",
        "guidance": "\u8a18\u8005\u4f1a\u898b\u3092\u884c\u3046\u5834\u5408\u306f\u767a\u8868\u8005\u306e\u6e96\u5099\u3092\u5341\u5206\u306b\u884c\u3044\u3001FAQ\u3084\u60f3\u5b9a\u554f\u7b54\u3092\u7528\u610f\u3057\u3066\u4e0d\u7528\u610f\u306a\u767a\u8a00\u3092\u907f\u3051\u308b\u3002\u5371\u6a5f\u5bfe\u5fdc\u3084\u8b1d\u7f6a\u4f1a\u898b\u3067\u306f\u7279\u306b\u767a\u8a00\u306e\u5f71\u97ff\u3068\u6f14\u51fa\u306b\u6ce8\u610f\u3059\u308b\u3002"
      },
      {
        "name": "Special considerations for apology/conflict announcements",
        "description": "\u4e0d\u7965\u4e8b\u304c\u767a\u751f\u3057\u305f\u8b1d\u7f6a\u4f1a\u898b\u306e\u5834\u5408\u306f\u3001\u30ab\u30e1\u30e9\u306e\u30d5\u30e9\u30c3\u30b7\u30e5\u3084\u7167\u660e\u3092\u6d74\u3073\u306a\u304c\u3089\u7dca\u8feb\u3057\u305f\u96f0\u56f2\u6c17\u3067\u884c\u308f\u308c\u3001\u8a18\u8005\u304b\u3089\u3082\u53b3\u3057\u3044\u8cea\u554f\u304c\u98db\u3073\u51fa\u3059\u3053\u3068\u306b\u306a\u308b\u3002",
        "guidance": "\u8b1d\u7f6a\u30fb\u4e0d\u7965\u4e8b\u5bfe\u5fdc\u306e\u767a\u8868\u306f\u9ad8\u3044\u6ce8\u76ee\u3068\u53b3\u3057\u3044\u53d6\u6750\u304c\u4e88\u60f3\u3055\u308c\u308b\u305f\u3081\u3001\u6cd5\u52d9\u30fb\u5e83\u5831\u30fb\u7d4c\u55b6\u30ec\u30d9\u30eb\u3067\u306e\u8abf\u6574\u3001\u4e8b\u524d\u306e\u30b7\u30ca\u30ea\u30aa\u4f5c\u6210\u3001\u9069\u5207\u306a\u5834\u306e\u8a2d\u55b6\u304c\u5fc5\u8981\u3067\u3042\u308b\u3002"
      },
      {
        "name": "Use of PR distribution services and outsourcing",
        "description": "\u30d7\u30ec\u30b9\u30ea\u30ea\u30fc\u30b9\u6587\u66f8\u306e\u4f5c\u6210\u3001\u304a\u3088\u3073\u305d\u308c\u3092\u5831\u9053\u5404\u793e\u306b\u5c4a\u3051\u308b\u4ed5\u4e8b\u3092\u3001\u4f01\u696d\u304b\u3089\u8acb\u3051\u8ca0\u3063\u3066\u3044\u308b\u4f1a\u793e\uff08PR\u4f1a\u793e\uff09\u3082\u3042\u308b\u3002PR\u4f1a\u793e\u306e\u914d\u4fe1\u4ee3\u884c\u30b5\u30fc\u30d3\u30b9\u3092\u4f7f\u3044\u3001\u5e83\u5831\u8cc7\u6599\u3092\u9001\u308b\u3053\u3068\u3082\u53ef\u80fd\u3067\u3042\u308b\u3002",
        "guidance": "\u30ea\u30bd\u30fc\u30b9\u3084\u5c02\u9580\u6027\u304c\u4e0d\u8db3\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u4fe1\u983c\u3067\u304d\u308bPR\u4f1a\u793e\u306b\u4f5c\u6210\u30fb\u914d\u4fe1\u3092\u59d4\u8a17\u3059\u308b\u3002\u305f\u3060\u3057\u914d\u4fe1\u30ea\u30b9\u30c8\u3084\u5831\u9053\u95a2\u4fc2\u306e\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u3001\u8cbb\u7528\u5bfe\u52b9\u679c\u3092\u78ba\u8a8d\u3059\u308b\u3053\u3068\u3002"
      },
      {
        "name": "Archiving and retention of press releases",
        "description": "\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u4e0a\u3067\u306e\u904e\u53bb\u306e\u30d7\u30ec\u30b9\u30ea\u30ea\u30fc\u30b9\u306e\u4fdd\u5b58\u671f\u9593\u306f\u3001\u6570\u304b\u6708\u3067\u524a\u9664\u3059\u308b\u4f01\u696d\u304b\u3089\u300110\u5e74\u4ee5\u4e0a\u306b\u6e21\u3063\u3066\u4fdd\u5b58\u3057\u3066\u3044\u308b\u4f01\u696d\u307e\u3067\u69d8\u3005\u3067\u3042\u308b\u3002",
        "guidance": "\u4fdd\u5b58\u671f\u9593\u306f\u7d44\u7e54\u306e\u900f\u660e\u6027\u65b9\u91dd\u3084\u6cd5\u7684\u30fbIR\u8981\u4ef6\u306b\u5fdc\u3058\u3066\u6c7a\u5b9a\u3059\u308b\u3002\u9577\u671f\u4fdd\u5b58\u306f\u5229\u5bb3\u95a2\u4fc2\u8005\u3084\u7814\u7a76\u8005\u306b\u3068\u3063\u3066\u6709\u76ca\u3060\u304c\u3001\u53e4\u3044\u60c5\u5831\u304c\u8aa4\u89e3\u3092\u751f\u307e\u306a\u3044\u3088\u3046\u9069\u5207\u306a\u30e9\u30d9\u30ea\u30f3\u30b0\uff08\u30a2\u30fc\u30ab\u30a4\u30d6\u8868\u793a\uff09\u3092\u884c\u3046\u3002"
      }
    ]
  }
}