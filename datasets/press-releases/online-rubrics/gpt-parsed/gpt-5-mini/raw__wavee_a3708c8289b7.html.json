        "description": "\u201c\u91c7\u96c6\u4fe1\u606f\uff1a\u4fe1\u606f\u662f\u9884\u6d4b\u548c\u51b3\u7b56\u7684\u57fa\u7840\u2026\u2026\u5305\u62ec\u4ea7\u54c1\u5f62\u8c61\u4fe1\u606f\u3001\u7ec4\u7ec7\u5f62\u8c61\u4fe1\u606f\u3001\u7ec4\u7ec7\u8fd0\u884c\u72b6\u6001\u548c\u53d1\u5c55\u8d8b\u52bf\u4fe1\u606f\u3001\u793e\u4f1a\u73af\u5883\u4fe1\u606f\u548c\u6709\u5173\u516c\u4f17\u7684\u4fe1\u606f\u7b49\u3002\u76d1\u89c6\u73af\u5883\uff1a\u91c7\u96c6\u7684\u4fe1\u606f\u7ecf\u8fc7\u52a0\u5de5\u6574\u7406\u5206\u6790\u540e\uff0c\u53ef\u53d1\u6325\u76d1\u6d4b\u653f\u5e9c\u51b3\u7b56\u8d8b\u52bf\u3001\u76d1\u6d4b\u793e\u4f1a\u73af\u5883\u53d8\u5316\u8d8b\u52bf\u548c\u76d1\u6d4b\u7ade\u4e89\u5bf9\u624b\u7684\u53d1\u5c55\u52a8\u6001\u7b49\u4f5c\u7528\u3002\u201d",
        "guidance": "\u5f3a\u8c03\u7814\u7a76\u73af\u8282\u7684\u6570\u636e\u5168\u9762\u6027\u4e0e\u5206\u6790\u6df1\u5ea6\uff1b\u8bc4\u4f30\u7814\u7a76\u65f6\u8003\u8651\u4fe1\u606f\u79cd\u7c7b\u3001\u52a0\u5de5\u4e0e\u5206\u6790\u65b9\u6cd5\uff0c\u4ee5\u53ca\u7814\u7a76\u7ed3\u8bba\u80fd\u5426\u652f\u6301\u540e\u7eed\u51b3\u7b56\u3002"
      },
      {
        "name": "\u5f15\u5bfc\u8206\u8bba\u4e0e\u5851\u9020\u5f62\u8c61",
        "description": "\u201c\u901a\u8fc7\u516c\u5173\u6d3b\u52a8\uff0c\u7ec4\u7ec7\u53ef\u4ee5\u5b9e\u73b0\u5f15\u5bfc\u516c\u4f17\u7406\u89e3\u5e76\u63a5\u53d7\u81ea\u5df1\uff1a\u7ec4\u7ec7\u53ef\u4ee5\u901a\u8fc7\u4ecb\u7ecd\u3001\u5ba3\u4f20\u6765\u63d0\u9ad8\u81ea\u5df1\u5728\u516c\u4f17\u4e2d\u7684\u8ba4\u77e5\u5ea6\u548c\u8ba4\u53ef\u5ea6\uff1b\u63d0\u5021\u7ef4\u62a4\u4ea7\u54c1\u5728\u516c\u4f17\u5fc3\u76ee\u4e2d\u7684\u826f\u597d\u5f62\u8c61\uff1b\u5728\u7ec4\u7ec7\u5f62\u8c61\u6e38\u79bb\u4e0d\u5b9a\u751a\u81f3\u53d7\u635f\u65f6\uff0c\u53ef\u4ee5\u901a\u8fc7\u516c\u5171\u5173\u7cfb\u6d3b\u52a8\uff0c\u6839\u636e\u5b9e\u9645\u60c5\u51b5\u91c7\u53d6\u76f8\u5e94\u7684\u63aa\u65bd\u6765\u5f15\u5bfc\u8206\u8bba\uff0c\u91cd\u5851\u5f62\u8c61\u3002\u201d",
        "guidance": "\u8bc4\u4f30\u5e94\u5173\u6ce8\u7b56\u7565\u662f\u5426\u9488\u5bf9\u6027\u5730\u63d0\u9ad8\u8ba4\u77e5\u4e0e\u8ba4\u53ef\u3001\u662f\u5426\u6709\u4fee\u590d\u5f62\u8c61\u7684\u5177\u4f53\u63aa\u65bd\u4ee5\u53ca\u8fd9\u4e9b\u63aa\u65bd\u662f\u5426\u4e0e\u4e8b\u5b9e\u4e0e\u4f26\u7406\u76f8\u7b26\u3002"
      },
      {
        "name": "\u6c9f\u901a\u5185\u5916\u3001\u534f\u8c03\u5173\u7cfb\uff08\u5185\u5916\u6c9f\u901a\u4e0e\u534f\u8c03\uff09",
        "description": "\u201c\u516c\u5171\u5173\u7cfb\u6d3b\u52a8\u53ef\u4ee5\u5e2e\u52a9\u7ec4\u7ec7\u534f\u8c03\u4e0e\u5916\u90e8\u516c\u4f17\u7684\u5173\u7cfb\uff1a\u51cf\u5c11\u4e0e\u666e\u901a\u516c\u4f17\u3001\u653f\u5e9c\u3001\u5a92\u4f53\u3001\u4f01\u4e1a\u548c\u5176\u5b83\u7ec4\u7ec7\u4e4b\u95f4\u7684\u6469\u64e6\u548c\u51b2\u7a81\u2026\u2026\u8fd8\u53ef\u4ee5\u534f\u8c03\u548c\u5185\u90e8\u516c\u4f17\u7684\u5173\u7cfb\uff0c\u589e\u52a0\u7ec4\u7ec7\u5185\u90e8\u7684\u51dd\u805a\u529b\uff0c\u4fc3\u8fdb\u7ec4\u7ec7\u5185\u90e8\u56e2\u7ed3\u3002\u201d",
        "guidance": "\u8bc4\u4f30\u516c\u5173\u9879\u76ee\u5e94\u67e5\u770b\u662f\u5426\u517c\u987e\u5185\u5916\u6c9f\u901a\u3001\u662f\u5426\u6709\u9488\u5bf9\u4e0d\u540c\u5229\u76ca\u76f8\u5173\u8005\u7684\u534f\u8c03\u673a\u5236\uff0c\u4ee5\u53ca\u662f\u5426\u6709\u52a9\u4e8e\u964d\u4f4e\u51b2\u7a81\u3001\u63d0\u5347\u5185\u90e8\u51dd\u805a\u529b\u3002"
      },
      {
        "name": "\u516c\u4f17\u8bc6\u522b\u4e0e\u5206\u7c7b\uff08\u6309\u5173\u7cfb\u3001\u6001\u5ea6\u3001\u91cd\u8981\u6027\u3001\u9891\u7387\u3001\u7ec4\u7ec7\u6001\u5ea6\u7b49\uff09",
        "description": "\u9875\u9762\u5217\u51fa\u516c\u4f17\u5206\u7c7b\u7ef4\u5ea6\uff1a\u6309\u516c\u4f17\u4e0e\u7ec4\u7ec7\u7684\u5185\u5916\u5173\u7cfb\u3001\u6309\u516c\u4f17\u5bf9\u7ec4\u7ec7\u7684\u6001\u5ea6\u3001\u6309\u516c\u4f17\u5bf9\u7ec4\u7ec7\u7684\u91cd\u8981\u6027\u3001\u6309\u516c\u4f17\u4e0e\u7ec4\u7ec7\u53d1\u751f\u5173\u7cfb\u7684\u65f6\u95f4\u9891\u7387\u3001\u6309\u7ec4\u7ec7\u5bf9\u516c\u4f17\u7684\u6001\u5ea6\uff08\u5982\uff1a\u5185\u90e8\u516c\u4f17/\u5916\u90e8\u516c\u4f17\u3001\u987a\u610f/\u9006\u610f/\u8fb9\u7f18\u516c\u4f17\u3001\u9996\u8981/\u6b21\u8981/\u4e00\u822c/\u7a33\u5b9a/\u4e34\u65f6/\u5468\u671f/\u8ffd\u6c42\u7684\u516c\u4f17\u7b49\uff09\u3002",
        "guidance": "\u5c06\u53d7\u4f17\u7ec6\u5206\u89c6\u4e3a\u5236\u5b9a\u4f20\u64ad\u7b56\u7565\u548c\u8bc4\u4ef7\u6210\u6548\u7684\u57fa\u7840\uff1b\u8bc4\u4f30\u65b9\u6848\u65f6\u68c0\u67e5\u662f\u5426\u6b63\u786e\u8bc6\u522b\u5e76\u4f18\u5148\u5b89\u6392\u5173\u952e\u516c\u4f17\uff08\u9996\u8981\u516c\u4f17\uff09\uff0c\u53ca\u5bf9\u5e94\u4fe1\u606f\u4e0e\u6e20\u9053\u662f\u5426\u5339\u914d\u3002"
      },
      {
        "name": "\u7f51\u7edc\u516c\u5171\u5173\u7cfb\uff08Web Public Relations\uff09",
        "description": "\u201c\u968f\u7740\u4e92\u8054\u7f51\u7684\u5e7f\u6cdb\u5e94\u7528\u2026\u2026\u516c\u5171\u5173\u7cfb\u4fe1\u606f\u7684\u4f20\u64ad\u5f00\u59cb\u5448\u73b0\u5373\u65f6\u6027\u3001\u6e20\u9053\u591a\u6837\u5316\u7b49\u7279\u70b9\u3002\u65e0\u8bba\u662f\u4f01\u4e1a\u6216\u516c\u8425\u673a\u6784\u90fd\u5f00\u59cb\u5229\u7528\u591a\u4e2a\u793e\u4ea4\u5e73\u53f0\u4f5c\u4f20\u8baf\u7528\u9014\uff0c\u6b63\u56e0\u8baf\u606f\u5728\u7f51\u7edc\u4e0a\u7684\u4f20\u9012\u5feb\uff0c\u5927\u5927\u589e\u52a0\u516c\u5173\u5371\u673a\u7684\u673a\u4f1a\u3002\u201d",
        "guidance": "\u8bc4\u4f30\u7f51\u7edc\u516c\u5173\u65f6\u5173\u6ce8\u4fe1\u606f\u4f20\u64ad\u901f\u5ea6\u3001\u591a\u6e20\u9053\u4e00\u81f4\u6027\u3001\u793e\u4ea4\u5a92\u4f53\u7684\u76d1\u6d4b\u4e0e\u54cd\u5e94\u673a\u5236\uff0c\u4ee5\u53ca\u5371\u673a\u9884\u8b66\u4e0e\u5904\u7f6e\u7684\u51c6\u5907\u7a0b\u5ea6\u3002"
      },
      {
        "name": "\u6574\u5408\u884c\u9500\u4f20\u64ad\u5b66\u6d3e\u7684\u5224\u65ad\uff08PR \u5728 IMC \u4e2d\u7684\u89d2\u8272\uff09",
        "description": "\u201c\u6574\u5408\u884c\u9500\u4f20\u64ad\u5b66\u6d3e\u4ea6\u8ba4\u4e3a\u516c\u5171\u5173\u7cfb\u662f\u2018\u5bf9\u6240\u6709\u6709\u5173\u4ea7\u54c1\u6216\u670d\u52a1\u7684\u6d88\u606f\u6765\u6e90\uff0c\u8fdb\u884c\u6574\u5408\u7ba1\u7406\uff0c\u589e\u52a0\u6216\u7ef4\u6301\u987e\u5ba2\u8d2d\u4e70\u884c\u4e3a\u4ee5\u53ca\u7ef4\u6301\u54c1\u724c\u5fe0\u8bda\u5ea6\u2019\u3002\u91cd\u89c6\u2018\u6570\u636e\u5e93\u884c\u9500\u2019\u4e0e\u4e00\u5bf9\u4e00\u4f20\u64ad\uff0c\u5f3a\u8c03\u2018\u5355\u4e00\u4fe1\u606f\u2019\uff0c\u8ba4\u4e3a\u516c\u5173\u4e1a\u52a1\u4e3b\u8981\u662f\u8981\u5904\u7406\u2018\u8425\u9500\u63a8\u5e7f\u2019\u7684\u95ee\u9898\uff0c\u76ee\u7684\u662f\u4e3a\u4e86\u589e\u52a0\u4ea7\u54c1\u9500\u552e\u3001\u670d\u52a1\u4f7f\u7528\u3002\u201d",
        "guidance": "\u5f53\u516c\u5171\u5173\u7cfb\u88ab\u7eb3\u5165\u6574\u5408\u8425\u9500\u4f20\u64ad\uff08IMC\uff09\u6846\u67b6\u65f6\uff0c\u8bc4\u4f30\u91cd\u70b9\u5305\u62ec\u4fe1\u606f\u6574\u5408\u5ea6\u3001\u4e0e\u8425\u9500\u6d3b\u52a8\u7684\u4e00\u81f4\u6027\u3001\u662f\u5426\u5229\u7528\u6570\u636e\u8fdb\u884c\u7cbe\u51c6\u4f20\u64ad\u4ee5\u53ca\u5bf9\u9500\u552e/\u5fe0\u8bda\u5ea6\u76ee\u6807\u7684\u8d21\u732e\u3002"
      },
      {
        "name": "\u827e\u7ef4\u00b7\u674e\u7684\u539f\u5219\u5ba3\u8a00\uff08\u804c\u4e1a\u4f26\u7406\uff1a\u2018\u8bf4\u771f\u8bdd\u2019\uff09",
        "description": "\u63d0\u52301906 \u5e74\u827e\u7ef4\u00b7\u674e\u53d1\u8868\u7684\u8457\u540d\u7684\u300a\u539f\u5219\u5ba3\u8a00\u300b\uff08Declaration of Principles\uff09\uff0c\u5e76\u5c06\u5176\u4f5c\u4e3a\u516c\u5171\u5173\u7cfb\u804c\u4e1a\u5316\u4e0e\u4f26\u7406\u7684\u91cd\u8981\u5386\u53f2\u6807\u5fd7\uff0c\u5f3a\u8c03\u201c\u8bf4\u771f\u8bdd\u201d\u7b49\u804c\u4e1a\u539f\u5219\u3002",
        "guidance": "\u4f5c\u4e3a\u516c\u5173\u4f26\u7406\u4e0e\u6267\u884c\u6807\u51c6\u7684\u5386\u53f2\u4f9d\u636e\uff1a\u8bc4\u4f30\u516c\u5173\u65b9\u6848\u548c\u6267\u884c\u5e94\u68c0\u89c6\u4fe1\u606f\u662f\u5426\u771f\u5b9e\u3001\u662f\u5426\u9075\u5b88\u804c\u4e1a\u4f26\u7406\uff0c\u4ee5\u53ca\u662f\u5426\u6709\u900f\u660e\u539f\u5219\u4ee5\u9632\u6b62\u516c\u5173\u707e\u96be\u3002"
      }
    ]
  }
}