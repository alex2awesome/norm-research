if (TrackingConsentManager.canTrackCurrentUser()) {
   trackStatus = 'granted';
   if(gtCookie('prsa-tracking-consent') != 'true') {
	  stCookie('prsa-tracking-consent',true, {'domain':'prsa.org', 'max-age': 34300800});
