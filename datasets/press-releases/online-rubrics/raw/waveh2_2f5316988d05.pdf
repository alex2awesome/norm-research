function consentGranted() {
  gtag('consent', 'update', {
    'ad_storage': 'granted',
    'ad_user_data': 'granted',
    'ad_personalization': 'granted',
    'analytics_storage': 'granted'
  });
  stCookie('prsa-tracking-consent',true, {'domain':'prsa.org', 'max-age': 34300800});
}

function consentNotGranted() {
  gtag('consent', 'update', {
    'ad_storage': 'denied',
