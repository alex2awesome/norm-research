<style>
  .top-bar {
    background-color: rgba(#null, 1.0);
    color: rgba(204, 204, 204, 1.0);
  }
  .top-bar svg,
  .top-bar svg g {
    fill: rgba(204, 204, 204, 1.0);
  }
  .close-top-bar i {
    color: rgba(204, 204, 204, 1.0);
    opacity: 0.8;
    position: absolute;
    right: 15px;
    font-size: 1.3rem;
    top: 50%;
    -webkit-transform: translateY(-50%);
    -ms-transform: translateY(-50%);
    transform: translateY(-50%);
  }
  .navbar-nav .nav-link:not(.btn) {
    padding-right: 0;
    padding-left: 0
  }
  .navbar-collapse {
    flex-basis: 100%;
    flex-grow: 1;
    align-items: center
  }
  .navbar-toggler {
    padding: 0;
