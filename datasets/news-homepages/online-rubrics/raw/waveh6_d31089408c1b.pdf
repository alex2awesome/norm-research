<script>
	document.addEventListener('focusin', function(event) {
	  // Check if focus has moved into a Slick slider (or any element inside it)
	  const focusedSlider = event.target.closest('.slick-slider');

	  if (focusedSlider) {
			console.log("focussed in")
	    // Loop over all Slick sliders on the page
	    $('.slick-slider.slick-initialized').each(function() {
	      // Pause each one (whether it's the focused one or not)
	      $(this).slick('slickPause');
//				$(this).slick('slickSetOption', 'autoplay', false, true);
	    });
	  }
	});
</script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const menuLinks = document.querySelectorAll(".bottom-bar .hs-menu-wrapper a");

		function clearHubSpotCookieConsent() {
		  // HubSpot cookie names can vary, but these are typical ones to clear consent state
			const cookiesToClear = [
        '__hs_cookie_cat_pref',
        '__hs_opt_out',
        '__hs_do_not_track',
        'hubspotutk'
      ];

      cookiesToClear.forEach(name => {
        document.cookie = `${name}=; path=/; domain=${location.hostname}; expires=Thu, 01 Jan 1970 00:00:00 GMT`;
        document.cookie = `${name}=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT`; // fallback without domain
      });
		}

    menuLinks.forEach(link => {
      if (link.getAttribute("href") === "#modify-cookie-settings") {
        link.textContent = "Cookie Settings";
        link.href = "javascript:void(0)";
        link.addEventListener("click", function (e) {
          e.preventDefault();
          // Open HubSpot cookie settings modal
					clearHubSpotCookieConsent();
          if (window._hsp) {
						console.log("Cookie showBanner modal called");
            window._hsp.push(['showBanner']);
          } else {
            console.warn("Cookie banner not found.");
          }
        });
      }
    });
  });
</script>

<script>
  function waitForCookieModal(attempts = 0) {
    const modal = document.getElementById("hs-eu-cookie-confirmation");

    if (modal) {
      console.log("✅ Cookie modal found!");

      // 1. Add accessible name
      modal.setAttribute("aria-label", "Cookie preferences dialog");
			modal.setAttribute("tabindex", "-1");

      // 2. Hide background content
      document.querySelectorAll('body > *:not(#hs-eu-cookie-confirmation):not(#focus-start):not(#focus-end)').forEach(el => {
        el.setAttribute('aria-hidden', 'true');
      });

      // 3. Add focus trap sentinels
      addFocusSentinels(modal);

    } else if (attempts < 20) {
      setTimeout(() => waitForCookieModal(attempts + 1), 250);
    } else {
      console.warn("⚠️ Cookie modal dismissed.");
    }
  }

  function addFocusSentinels(modal) {
    const focusableSelectors = 'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])';
    const focusableEls = modal.querySelectorAll(focusableSelectors);
    if (focusableEls.length === 0) return;

    const firstEl = focusableEls[0];
    const lastEl = focusableEls[focusableEls.length - 1];

    // Create invisible sentinels
    const startTrap = document.createElement('div');
    startTrap.tabIndex = 0;
    startTrap.id = 'focus-start';
    startTrap.style.cssText = 'position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;';
    startTrap.addEventListener('focus', () => lastEl.focus());

    const endTrap = document.createElement('div');
    endTrap.tabIndex = 0;
    endTrap.id = 'focus-end';
    endTrap.style.cssText = 'position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;';
    endTrap.addEventListener('focus', () => firstEl.focus());

    // Insert before and after modal
    modal.parentNode.insertBefore(startTrap, modal);
    modal.parentNode.insertBefore(endTrap, modal.nextSibling);

    // Focus first focusable element
    firstEl.focus();
  }

	document.addEventListener("DOMContentLoaded", function () {
	  waitForCookieModal();

		const confirmButton = document.getElementById("hs-eu-confirmation-button");
  	if (confirmButton) {
	    confirmButton.focus();
	  }
	});
</script>
	
