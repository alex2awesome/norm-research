        "guidance": "\uc724\ub9ac\uc801 \uae30\uc900(\uc815\ud655\uc131, \uacf5\uc815\uc131, \ucd9c\ucc98 \ubcf4\ud638 \ub4f1)\uacfc \uad00\ub828 \ubc95\uaddc\ub97c \uc900\uc218\ud574\uc57c \ud558\uba70, \uba85\uc608\ud6fc\uc190 \uc704\ud5d8\uc744 \uc0ac\uc804\uc5d0 \uace0\ub824\ud574\uc57c \ud55c\ub2e4."
      },
      {
        "name": "\ub274\uc2a4 \uac00\uce58(\ub274\uc2a4 \uc120\uc815 \uae30\uc900)",
