      {
        "name": "\ub9e5\ub77d\uc800\ub110\ub9ac\uc998(\ud574\uc124\u00b7\ube44\ud3c9\uc744 \ud1b5\ud55c \ub9e5\ub77d \uc81c\uacf5)",
        "description": "\ub9e5\ub77d\uc800\ub110\ub9ac\uc998\uc740 \ud55c \uc0ac\uc548\uc5d0 \ub300\ud574 \uc9e7\uac8c\ub294 3\ubd84, \uae38\uac8c\ub294 10\ubd84 \uac00\uae4c\uc774 \ud574\uc124\u00b7\ube44\ud3c9\uc744 \ud1b5\ud574 \ub9e5\ub77d\uc744 \uc81c\uacf5\ud558\ub294 \ubcf4\ub3c4 \ubc29\uc2dd\uc774\ub2e4.",
        "guidance": "\ub2e8\ud3b8\uc801 \uc18d\ubcf4 \uc911\uc2ec \ubcf4\ub3c4 \ub300\uc2e0 \ubc30\uacbd\u00b7\ud574\uc124\uc744 \uc81c\uacf5\ud558\uc5ec \ub3c5\uc790\uac00 \uc0ac\uc548\uc744 \uc774\ud574\ud560 \uc218 \uc788\ub3c4\ub85d \ub9e5\ub77d\uc744 \uc81c\uacf5\ud558\ub294 \uac83\uc774 \uad8c\uc7a5\ub41c\ub2e4."
      },
      {
        "name": "\uc815\uc5b8\uc720\ucc29\u00b7\uc5ec\ub860 \uc870\uc791 \ubc29\uc9c0(\ud669\uc0c9\uc5b8\ub860 \ubb38\uc81c)",
        "description": "\ud669\uc0c9\uc5b8\ub860\uc758 \ud070 \ubb38\uc81c\ub294 \uc815\uce58\uc640 \uc5b8\ub860\uc774 \uc0ac\uc801 \uc774\uc775\uc744 \uc704\ud574 \uacb0\ud569\ud558\uba74\uc11c \uc5b8\ub860\uc0ac\uac00 \uc815\uce58\uc801 \ud3b8\ud5a5\uc744 \ub760\uace0 \ub300\uc911\uc5d0\uac8c \ud3b8\ud5a5\ub41c \uc815\ubcf4\ub97c \uc804\ud558\uc5ec \uc5ec\ub860\uc744 \uc870\uc791\ud560 \uc704\ud5d8\uc774 \uc788\ub2e4\ub294 \uc810\uc774\ub2e4.",
        "guidance": "\uc5b8\ub860\uc740 \uc815\uce58\uc801\u00b7\uc0ac\uc801 \uc774\uc775\uacfc\uc758 \uc720\ucc29\uc744 \ud53c\ud558\uace0 \uacf5\uc815\uc131\uc744 \uc720\uc9c0\ud574\uc57c \ud558\uba70, \ud3b8\ud5a5\uc801 \ubcf4\ub3c4\ub294 \ubbfc\uc8fc\uc801 \uc5ec\ub860 \ud615\uc131\uc744 \uc800\ud574\ud55c\ub2e4."
      },
      {
        "name": "\uc5b8\ub860\uc724\ub9ac \ubc0f \ubc95\uc801\uc81c\uc57d(\uba85\uc608\ud6fc\uc190 \ub4f1)",
