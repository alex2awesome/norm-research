        "guidance": "\ub274\uc2a4 \uac00\uce58\ub294 \ub3c5\uc790\uc131\u00b7\uc2dc\uc758\uc131\u00b7\uc601\ud5a5\ub825 \ub4f1 \uc5ec\ub7ec \uc694\uc18c\ub85c \uad6c\uc131\ub418\uba70, \ubcf4\ub3c4 \uc6b0\uc120\uc21c\uc704 \uc124\uc815\uc5d0 \ud65c\uc6a9\ub41c\ub2e4."
