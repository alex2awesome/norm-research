    "subtask_breadth": "broad",
    "error": null,
    "rubrics_metrics": [
      {
        "name": "\uc815\ud655\uc131(\uc815\ubcf4 \uc81c\uacf5)",
        "description": "\uc800\ub110\ub9ac\uc998\uc740 \uc0ac\uac74, \uc0ac\uc2e4, \uc544\uc774\ub514\uc5b4, \uc0ac\ub78c\uc758 \uc0c1\ud638 \uc791\uc6a9\uc5d0 \ub300\ud55c \ubcf4\uace0\uc11c\ub97c \uc0dd\uc0b0\ud558\uace0 \ubc30\ud3ec\ud558\uba70 '\uc0ac\ud68c\uc5d0 \ucd5c\uc18c\ud55c \uc5b4\ub290 \uc815\ub3c4 \uc815\ud655\ud558\uac8c \uc815\ubcf4\ub97c \uc81c\uacf5'\ud55c\ub2e4.",
        "guidance": "\uc800\ub110\ub9ac\uc998\uc758 \ud575\uc2ec\uc801 \uae30\uc900\uc73c\ub85c\uc11c \ubcf4\ub3c4\ub294 \ub300\uc911\uc5d0\uac8c \uc0ac\uc2e4\uc5d0 \uae30\ubc18\ud55c \uc815\ubcf4\ub97c \uc81c\uacf5\ud574\uc57c \ud55c\ub2e4\ub294 \uc810\uc744 \uac15\uc870\ud55c\ub2e4."
      },
      {
        "name": "\uc5b8\ub860\uc758 \ub3c5\ub9bd\uc131/\uc5b8\ub860\uc758 \uc790\uc720",
        "description": "\uc800\ub110\ub9ac\uc998\uc758 \uc801\uc808\ud55c \uc5ed\ud560\uacfc \uc9c1\uc5c5\uc801 \uc9c0\uc704\ub294 \uad6d\uac00\ub9c8\ub2e4 \ub2e4\ub974\uba70, '\uc77c\ubd80 \uad6d\uac00\uc5d0\uc11c\ub294 \ub274\uc2a4 \ub9e4\uccb4\uac00 \uc815\ubd80\uc5d0 \uc758\ud574 \ud1b5\uc81c'\ub418\uae30\ub3c4 \ud558\ub294 \ubc18\uba74 \ub2e4\ub978 \uacf3\uc5d0\uc11c\ub294 \ub3c5\ub9bd\uc801\uc73c\ub85c \uc6b4\uc601\ub41c\ub2e4.",
        "guidance": "\uc5b8\ub860\uc758 \uc790\uc720\uc640 \ub3c5\ub9bd\uc131\uc740 \ubcf4\ub3c4\uc758 \uc2e0\ub8b0\uc131\uacfc \uacf5\uacf5\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uac01\uad6d\uc758 \uba85\uc608\ud6fc\uc190\u00b7\uc5b8\ub860\uc790\uc720 \ubc95\ub960\uc758 \uc2dc\ud589 \ucc28\uc774\uac00 \uc874\uc7ac\ud568\uc744 \uc720\uc758\ud574\uc57c \ud55c\ub2e4."
      },
      {
        "name": "\ucde8\uc7ac(\uc815\ubcf4 \uc218\uc9d1 \ubc29\ubc95)",
        "description": "\ucde8\uc7ac\ub294 \ub274\uc2a4\ub97c \uc0dd\uc0b0\ud558\uae30 \uc704\ud574 \uad00\ub828 \uc815\ubcf4\ub97c \uc218\uc9d1\ud558\ub294 \ud589\uc704\ub85c\uc11c, \ucd9c\uc785\ucc98\uc5d0 \uc815\uae30\uc801\uc73c\ub85c \ucd9c\uc785\ud558\uac70\ub098 \ud2b9\uc815 \ubd84\uc57c \uad00\ub828 \uc815\ubcf4\ub97c \uc218\uc9d1\ud558\ub294 \ubc29\ubc95\uc73c\ub85c \ub098\ub25c\ub2e4.",
        "guidance": "\ucde8\uc7ac \uc218\ub2e8\uc73c\ub85c \uc778\ud130\ubdf0, \uc790\ub8cc \uac80\uc0c9, \ubcf4\ub3c4 \uc790\ub8cc \ud65c\uc6a9 \ub4f1\uc774 \uc788\uc73c\uba70, \ucd9c\uc785\ucc98(beat)\uc640 \ubd84\uc57c\ubcc4(\ud2b9\uc815 \uc8fc\uc81c) \ucde8\uc7ac \ubc29\uc2dd\uc774 \ub300\ud45c\uc801\uc774\ub2e4."
      },
      {
        "name": "\ubcf4\ub3c4(\uc804\ub2ec \ubc29\uc2dd \ubc0f \ub9e4\uccb4 \uc801\ud569\uc131)",
        "description": "\ubcf4\ub3c4\ub294 \ucde8\uc7ac\ub85c \uc0dd\uc0b0\ud55c \ub274\uc2a4\ub97c \ub300\uc911\uc5d0\uac8c \uc804\ub2ec\ud558\ub294 \ud589\uc704\uc774\uba70, \ub9e4\uccb4 \ud2b9\uc131\uc5d0 \ub530\ub77c \uc2e0\ubb38\u00b7\uc7a1\uc9c0(\ud65c\uc790\u00b7\uc0ac\uc9c4), \ub77c\ub514\uc624(\uc74c\uc131), \ud154\ub808\ube44\uc804(\uc74c\uc131\u00b7\uc601\uc0c1), \uc778\ud130\ub137(\uae00\uc790\u00b7\uc0ac\uc9c4\u00b7\uc74c\uc131\u00b7\uc601\uc0c1)\uc774 \uc0ac\uc6a9\ub41c\ub2e4.",
        "guidance": "\ubcf4\ub3c4 \ud615\uc2dd\uc740 \ub9e4\uccb4\uc758 \ud2b9\uc131\uc5d0 \ub9de\uac8c \uc120\ud0dd\u00b7\ud3b8\uc9d1\ub418\uc5b4\uc57c \ud558\uba70, \uac01 \ub9e4\uccb4\uc758 \ud45c\ud604 \uc218\ub2e8\uc744 \uc801\uc808\ud788 \ud65c\uc6a9\ud558\ub294 \uac83\uc774 \uc694\uad6c\ub41c\ub2e4."
      },
      {
        "name": "\ucd9c\ucc98 \ucde8\uae09(\uc624\ud504 \ub354 \ub808\ucf54\ub4dc\u00b7\uc628 \ub354 \ub808\ucf54\ub4dc\u00b7\ubc31\uadf8\ub77c\uc6b4\ub4dc \ube0c\ub9ac\ud551\u00b7\uc775\uba85\uc81c\ubcf4)",
        "description": "\uc624\ud504 \ub354 \ub808\ucf54\ub4dc(\ube44\ubcf4\ub3c4 \uc57d\uc18d), \uc628 \ub354 \ub808\ucf54\ub4dc(\ubcf4\ub3c4 \uc804\uc81c \ubc1c\uc5b8), \ubc31\uadf8\ub77c\uc6b4\ub4dc \ube0c\ub9ac\ud551(\uc775\uba85 \ub610\ub294 \ube44\uacf5\uc2dd \uc124\uba85), \ub525 \uc2a4\ub85c\ud2b8(\uc775\uba85\uc758 \uc81c\ubcf4\uc790) \ub4f1 \ucd9c\ucc98\uc640 \ubc1c\uc5b8\uc758 \ucde8\uae09 \ubc29\uc2dd\uc774 \uad6c\ubcc4\ub41c\ub2e4.",
        "guidance": "\ucd9c\ucc98\uc640\uc758 \uc57d\uc18d\u00b7\uc775\uba85\uc131 \uc870\uac74\uc744 \uba85\ud655\ud788 \uc774\ud574\ud558\uace0 \uc900\uc218\ud574\uc57c \ud558\uba70, \uc775\uba85 \uc81c\ubcf4\uc758 \uc0ac\uc6a9\uacfc \ube44\ubcf4\ub3c4 \uc694\uccad\uc744 \uad00\ub9ac\ud558\ub294 \uc6d0\uce59\uc744 \uc9c0\ucf1c\uc57c \ud55c\ub2e4."
      },
      {
        "name": "\ubcf4\ub3c4\uc790\ub8cc\u00b7\ub274\uc2a4 \uc5e0\ubc14\uace0 \ucc98\ub9ac",
        "description": "\ubcf4\ub3c4\uc790\ub8cc\ub294 \uc815\ubd80\ub098 \uae30\uc5c5 \ub4f1\uc774 \ud64d\ubcf4 \ubaa9\uc801\uc73c\ub85c \uc5b8\ub860\uc5d0 \ubc30\ud3ec\ud558\ub294 \uc790\ub8cc\uc774\uba70, \ub274\uc2a4 \uc5e0\ubc14\uace0\ub294 \ucde8\uc7ac\ud55c \uc0ac\uc548\uc744 \uc77c\uc815 \uae30\uac04 \ubcf4\ub3c4\ud558\uc9c0 \uc54a\uae30\ub85c \uc57d\uc18d\ud558\ub294 \uac83\uc744 \ub73b\ud55c\ub2e4.",
        "guidance": "\ubcf4\ub3c4\uc790\ub8cc\ub294 \uc815\ubcf4\uc6d0\uc73c\ub85c \ud65c\uc6a9\ub420 \uc218 \uc788\uc73c\ub098 \ucd9c\ucc98\u00b7\uc774\uc775\uad00\uacc4\ub97c \ud655\uc778\ud574\uc57c \ud558\uace0, \uc5e0\ubc14\uace0 \uc57d\uc18d\uc744 \uc9c0\ud0a4\uac70\ub098 \uad00\ub828 \uc724\ub9ac\u00b7\uc2e4\ubb34 \uad00\ud589\uc744 \ub530\ub974\ub294 \uac83\uc774 \uc694\uad6c\ub41c\ub2e4."
      },
      {
        "name": "\ud2b9\uc885\u00b7\ub099\uc885(\ub3c5\uc810 \ubcf4\ub3c4\uc640 \uc0c1\uc2e4)",
        "description": "\ud2b9\uc885\uc740 \uc5b8\ub860\uc0ac\uac00 \ub2e8\ub3c5\uc73c\ub85c \uc5b4\ub5a4 \ub274\uc2a4\ub97c \ubcf4\ub3c4\ud558\ub294 \uac83\uc744 \ub9d0\ud558\uba70, \ub099\uc885\uc740 \uadf8 \ud2b9\uc885\uc744 \ub2e4\ub978 \uc5b8\ub860\uc0ac\uc5d0 \ube7c\uc557\uae30\ub294 \uac83\uc744 \ub73b\ud55c\ub2e4.",
        "guidance": "\ud2b9\uc885\uc740 \ub274\uc2a4 \uac00\uce58 \uce21\uba74\uc5d0\uc11c \uc911\uc694\ud55c \uc790\uc0b0\uc774\uc9c0\ub9cc, \ub3c5\uc810\uc131 \ucd94\uad6c\uac00 \uacf5\uc815\uc131\u00b7\uc815\ud655\uc131\uc744 \ud574\uce58\uc9c0 \uc54a\ub3c4\ub85d \uade0\ud615\uc744 \uc720\uc9c0\ud574\uc57c \ud55c\ub2e4."
      },
      {
        "name": "\uacbd\ub9c8\uc800\ub110\ub9ac\uc998 \ud68c\ud53c(\uc18d\ubcf4 \uacbd\uc7c1\uacfc \uc0ac\uc2e4\ud655\uc778)",
        "description": "\uacbd\ub9c8\uc800\ub110\ub9ac\uc998\uc740 \uc0ac\uc2e4\uad00\uacc4 \ud655\uc778 \uc5c6\uc774 \uc18d\ubcf4 \uacbd\uc7c1\uc774\ub098 \ubc1b\uc544\uc4f0\uae30\uc5d0\ub9cc \ubab0\ub450\ud558\uc5ec \ubcf4\ub3c4\ud558\ub294 \uac83\uc744 \ub9d0\ud55c\ub2e4.",
        "guidance": "\uc18d\ubcf4 \uacbd\uc7c1\uc5d0\uc11c \ubc97\uc5b4\ub098 \uc0ac\uc2e4 \ud655\uc778\uacfc \uac80\uc99d\uc744 \uc6b0\uc120\uc2dc\ud574\uc57c \ud558\uba70, \uacbd\ub9c8\uc800\ub110\ub9ac\uc998\uc740 \uc800\ub110\ub9ac\uc998\uc758 \uc2e0\ub8b0\ub97c \ud6fc\uc190\ud558\ub294 \ub300\ud45c\uc801 \ud3d0\ub2e8\uc73c\ub85c \uc9c0\uc801\ub41c\ub2e4."
