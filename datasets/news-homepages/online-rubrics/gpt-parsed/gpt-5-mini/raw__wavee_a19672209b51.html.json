      {
        "name": "\uac00\uc9dc\ub274\uc2a4 \ubc29\uc9c0(\ud5c8\uc704\uc815\ubcf4 \ubcf4\ub3c4 \uae08\uc9c0)",
        "description": "\uac00\uc9dc\ub274\uc2a4\ub294 \uac70\uc9d3 \uc815\ubcf4\ub97c \ubcf4\ub3c4\ud558\ub294 \uac83\uc744 \ub9d0\ud55c\ub2e4.",
        "guidance": "\ubcf4\ub3c4 \uc804 \uc9c4\uc704 \uac80\uc99d\uacfc \ucd9c\ucc98 \ud655\uc778\uc744 \ud1b5\ud574 \ud5c8\uc704\uc815\ubcf4\uc758 \ubcf4\ub3c4\ub97c \ucc28\ub2e8\ud574\uc57c \ud558\uba70, \uac00\uc9dc\ub274\uc2a4 \uc720\ud1b5\uc740 \uacf5\uacf5\uc131 \ud6fc\uc190\uc73c\ub85c \uc774\uc5b4\uc9c4\ub2e4."
