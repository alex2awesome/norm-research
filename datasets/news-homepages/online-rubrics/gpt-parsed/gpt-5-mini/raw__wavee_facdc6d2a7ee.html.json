        "guidance": "\u6761\u76ee\u5f15\u7528\u65e0\u56fd\u754c\u8bb0\u8005\u7b49\u7ec4\u7ec7\u7684\u51fa\u7248\u81ea\u7531\u6307\u6570\u3001\u4ee5\u53ca\u81ea\u4e60\u8fd1\u5e732012\u5e74\u4e0a\u4efb\u4ee5\u6765\u51fa\u7248\u81ea\u7531\u4e0b\u964d\u7684\u62a5\u9053\uff0c\u63cf\u8ff0\u5ba1\u67e5\u5b9e\u8df5\u3001\u793e\u4ea4\u5a92\u4f53\u5220\u5e16\u4e0e\u4e2a\u4eba\u81ea\u6211\u5ba1\u67e5\u7684\u73b0\u5b9e\u5f71\u54cd\u3002"
      },
      {
        "name": "\u653f\u52a1\u65b0\u5a92\u4f53\u8003\u6838\u4e0e\u89c4\u8303\uff08\u4e92\u52a8\u3001\u865a\u5047\u70b9\u8d5e\u7b49\uff09",
        "description": "\u653f\u5e9c\u90e8\u95e8\u5f00\u8bbe\u7684\u653f\u52a1\u65b0\u5a92\u4f53\u88ab\u7eb3\u5165\u8003\u6838\u6307\u6807\uff1a\u5982\u5bf9\u7f51\u53cb\u4e92\u52a8\u56de\u5e94\u5dee\u4f1a\u88ab\u6263\u5206\uff0c\u91c7\u7528\u5f3a\u5236\u8981\u6c42\u6c11\u4f17\u70b9\u8d5e\u7b49\u865a\u5047\u4e3e\u63aa\u5c06\u88ab\u5224\u5b9a\u4e0d\u5408\u683c\u3002",
        "guidance": "\u6761\u76ee\u4e3e\u4f8b\u8bf4\u660e\u5404\u7ea7\u653f\u52a1\u65b0\u5a92\u4f53\u5728\u5fae\u4fe1\u3001\u5fae\u535a\u7b49\u5e73\u53f0\u7684\u4f7f\u7528\u53d7\u5230\u7ee9\u6548\u8003\u6838\uff0c\u76d1\u7ba1\u673a\u5173\u4f1a\u5bf9\u4e70\u7c89\u3001\u5f3a\u5236\u70b9\u8d5e\u7b49\u884c\u4e3a\u8fdb\u884c\u76f4\u63a5\u5904\u7f5a\u6216\u8bc4\u4ef7\u4e0d\u5408\u683c\u3002"
      },
      {
        "name": "\u5bf9\u5916\u5a92\u4f53\u4e0e\u5916\u56fd\u8bb0\u8005\u5728\u534e\u91c7\u8bbf\u7684\u6cd5\u89c4\uff082008\u6761\u4f8b\uff09",
        "description": "2008\u5e74\u300a\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u5916\u56fd\u5e38\u9a7b\u65b0\u95fb\u673a\u6784\u548c\u5916\u56fd\u8bb0\u8005\u91c7\u8bbf\u6761\u4f8b\u300b\u53d6\u6d88\u4e86\u56fd\u5185\u5355\u4f4d\u966a\u540c\u7684\u8981\u6c42\uff0c\u8d4b\u4e88\u5916\u56fd\u5a92\u4f53\u5728\u534e\u66f4\u5927\u91c7\u8bbf\u81ea\u7531\uff0c\u4f46\u4ecd\u5c5e\u4e8e\u76d1\u7ba1\u6846\u67b6\u4e0b\u7684\u5236\u5ea6\u6027\u89c4\u8303\u3002",
        "guidance": "\u6761\u76ee\u6307\u51fa\u8be5\u6761\u4f8b\u662f\u5bf9\u5e38\u9a7b\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u7684\u5916\u56fd\u8bb0\u8005\u4e0e\u65b0\u95fb\u673a\u6784\u7684\u76d1\u7ba1\u6cd5\u89c4\uff0c\u5e76\u5bf9\u6bd4\u8fc7\u53bb\u966a\u540c\u5236\u5ea6\u7684\u53d8\u5316\uff0c\u8bf4\u660e\u5bf9\u5916\u8bb0\u8005\u7684\u6743\u5229\u5e76\u975e\u5b8c\u5168\u4e0d\u53d7\u7ea6\u675f\u3002"
      },
      {
        "name": "\u5e7f\u7535\u4e0e\u5176\u4ed6\u884c\u653f\u76d1\u7ba1\u673a\u6784\u901a\u8fc7\u89c4\u8303\u6027\u6587\u4ef6\u4e0e\u884c\u653f\u624b\u6bb5\u5e72\u9884\u5a92\u4f53",
        "description": "\u56fd\u5bb6\u5e7f\u64ad\u7535\u89c6\u603b\u5c40\uff08\u53ca\u524d\u8eab\uff09\u4e0e\u4e2d\u5ba3\u90e8\u7b49\u76d1\u7ba1\u673a\u6784\u901a\u8fc7\u9881\u5e03\u89c4\u8303\u6027\u6587\u4ef6\u3001\u6307\u4ee4\u3001\u5ba1\u6838\u51c6\u5165\u6761\u4ef6\u7b49\u65b9\u5f0f\u76d1\u7ba1\u5a92\u4f53\uff0c\u5e76\u4ee5\u6cd5\u5f8b\u4e0e\u6c11\u4e8b\u624b\u6bb5\u5f3a\u5316\u76d1\u7ba1\u5b9e\u65bd\u3002",
        "guidance": "\u6761\u76ee\u6307\u51fa\u56fd\u5bb6\u5e7f\u7535\u603b\u5c40\u57282000\u20132014\u5e74\u95f4\u53d1\u5e03\u4e86\u5927\u91cf\u89c4\u8303\u6027\u6587\u4ef6\uff08\u5982438\u4efd\uff09\uff0c\u5e76\u4ee5\u884c\u653f\u547d\u4ee4\u76f4\u63a5\u5e72\u9884\u4f01\u4e1a\u8fd0\u8425\uff0c\u8bf4\u660e\u884c\u653f\u6587\u4ef6\u662f\u4e3b\u8981\u7684\u76d1\u7ba1\u5de5\u5177\u4e4b\u4e00\u3002"
      },
      {
        "name": "\u7981\u6b62\u5236\u4f5c\u8272\u60c5\u3001\u5eb8\u4fd7\u3001\u53cd\u52a8\u5185\u5bb9\uff08\u5f71\u89c6\u4e0e\u51fa\u7248\u9886\u57df\u5185\u5bb9\u8981\u6c42\uff09",
        "description": "\u653f\u5e9c\u8981\u6c42\u5236\u7247\u4eba\u4e0d\u5f97\u5236\u4f5c\u8272\u60c5\u3001\u5eb8\u4fd7\u3001\u53cd\u52a8\u7684\u5185\u5bb9\u4f5c\u54c1\uff0c\u5e76\u91c7\u53d6\u63aa\u65bd\u4fc3\u4f7f\u5185\u5bb9\u521b\u4f5c\u8005\u81ea\u6211\u5ba1\u67e5\u4ee5\u7b26\u5408\u6cd5\u89c4\u4e0e\u5ba3\u4f20\u8981\u6c42\u3002",
        "guidance": "\u6761\u76ee\u56de\u987e\u5386\u53f2\u5ef6\u7eed\u6027\uff08\u56fd\u6c11\u653f\u5e9c\u65b0\u95fb\u5ba1\u67e5\u4f20\u7edf\uff09\u5e76\u6307\u51fa\u5177\u4f53\u7981\u9650\u4ee4\u5bf9\u5f71\u89c6\u3001\u51fa\u7248\u4e0e\u7f51\u7edc\u5185\u5bb9\u4ea7\u751f\u7684\u5f71\u54cd\uff0c\u5f3a\u8c03\u5236\u5ea6\u5316\u7684\u5185\u5bb9\u5ba1\u67e5\u4e0e\u81ea\u6211\u5ba1\u67e5\u5e76\u5b58\u3002"
      },
      {
        "name": "\u5a92\u4f53\u7ecf\u8425\u4f53\u5236\u4e0e\u6240\u6709\u5236\u53d8\u9769\u8981\u6c42\uff08\u4e8b\u4e1a\u5355\u4f4d\u8f6c\u5236\u4e3a\u4f01\u4e1a\u7b49\uff09",
        "description": "\u56fd\u52a1\u9662\u51b3\u5b9a\u5168\u56fd\u7ecf\u8425\u6027\u6587\u5316\u4e8b\u4e1a\u5355\u4f4d\u5728\u89c4\u5b9a\u671f\u9650\u524d\u5168\u90e8\u8f6c\u5236\u4e3a\u4f01\u4e1a\uff0c\u9664\u673a\u5173\u62a5\u4ee5\u5916\u7684\u5b98\u65b9\u5a92\u4f53\u5c06\u8f6c\u4e3a\u5e02\u573a\u5316\u56fd\u6709\u4f01\u4e1a\uff1b\u5a92\u4f53\u5546\u4e1a\u5316\u4e0e\u79c1\u6709\u8d44\u672c\u53c2\u4e0e\u5728\u6cd5\u5f8b\u4e0e\u653f\u7b56\u5c42\u9762\u53d7\u89c4\u5236\u3002",
        "guidance": "\u6761\u76ee\u63d0\u52302019\u5e743\u6708\u56fd\u52a1\u9662\u529e\u516c\u5385\u51b3\u5b9a\u7684\u8f6c\u5236\u65f6\u95f4\u8868\uff082023\u5e7412\u670831\u65e5\u524d\u5b8c\u6210\uff09\u53ca\u5a92\u4f53\u5546\u4e1a\u5316\u7684\u5386\u53f2\u8fdb\u7a0b\uff0c\u8bf4\u660e\u6240\u6709\u5236\u6539\u9769\u5982\u4f55\u4e0e\u76d1\u7ba1\u3001\u8d44\u8d28\u548c\u7ecf\u8425\u6743\u9650\u4ea4\u7ec7\u3002"
      },
      {
        "name": "\u5bf9\u7f51\u7edc\u4f20\u64ad\u95ee\u9898\u7684\u6cbb\u7406\u76ee\u6807\u4e0e\u91cd\u70b9\uff08\u6253\u51fb\u5047\u65b0\u95fb\u3001\u5938\u5927\u6807\u9898\u3001\u690d\u5165\u5f0f\u8425\u9500\u7b49\uff09",
        "description": "\u7f51\u7edc\u5a92\u4f53\u4e2d\u5f15\u8d77\u53cd\u611f\u7684\u4e3b\u8981\u95ee\u9898\u5305\u62ec\u5047\u65b0\u95fb\u3001\u5938\u5927\u6807\u9898\u3001\u690d\u5165\u5f0f\u8425\u9500\u3001\u8bdd\u9898\u7092\u4f5c\u53ca\u5eb8\u4fd7\u4fe1\u606f\uff0c\u76d1\u7ba1\u805a\u7126\u4e8e\u6cbb\u7406\u8fd9\u4e9b\u7f51\u7edc\u4e71\u8c61\u4ee5\u7ef4\u62a4\u7f51\u7edc\u751f\u6001\u3002",
        "guidance": "\u6761\u76ee\u63f4\u5f15\u8c03\u67e5\u4e0e\u884c\u4e1a\u62a5\u544a\uff08\u4f8b\u5982\u5de5\u4fe1\u90e8\u7684\u516c\u4fe1\u529b\u62a5\u544a\u548c\u62a5\u4e1a\u878d\u5408\u89c2\u5bdf\u62a5\u544a\uff09\uff0c\u5e76\u5217\u4e3e\u76d1\u7ba1\u65b9\u9488\u5982\u6574\u5408\u5ba2\u6237\u7aef\u3001\u6253\u51fb\u540c\u8d28\u5316\u4e0e\u4f4e\u4fd7\u5316\u5185\u5bb9\u3002"
      }
    ]
  }
