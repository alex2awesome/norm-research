.govuk-form-group {
  margin-bottom: 20px; }
  .govuk-form-group::after {
    content: "";
    display: block;
    clear: both; }
  @media (min-width: 40.0625em) {
    .govuk-form-group {
      margin-bottom: 30px; } }
  .govuk-form-group .govuk-form-group:last-of-type {
    margin-bottom: 0; }

.govuk-form-group--error {
  padding-left: 15px;
  border-left: 5px solid #d4351c; }
  .govuk-form-group--error .govuk-form-group {
    padding: 0;
    border: 0; }

