</script>
        <script>function addListeners(sectionUrl) {
    $(":input").blur(function () {
        refreshVisibility(sectionUrl)
    });
    $("input:radio").change(function () {
        refreshVisibility(sectionUrl);
    });
    $("input:checkbox").change(function () {
        refreshVisibility(sectionUrl);
    });
    $("select").change(function () {
        refreshVisibility(sectionUrl);
    });

    $('[data-module="govuk-tabs"] .govuk-tabs__list-item').click(function (e) {
        let index = [...e.target.closest('.govuk-tabs__list')
            .querySelectorAll('.govuk-tabs__list-item')]
            .findIndex(item => item === e.target.closest('.govuk-tabs__list-item'));

        $(e.target.closest('[data-module=\"govuk-tabs\"]')).find("input[type=\"hidden\"]")
            .attr("value", index)
    });

    $('[data-module="govuk-tabs"]').each(function( i, val ) {
        let index = $(val).find("input[type=\"hidden\"]").val();
        $(val).find(".govuk-tabs__tab")[index].click();
    });
}

function refreshVisibility(sectionUrl) {
    console.debug("refreshing visibility for " + sectionUrl);

    $.ajax({
        url: sectionUrl,
        type: 'POST',
        data: $("form").serializeArray(),
        dataType: 'json',
        success: function (response) {
            $.each(response, function (elementId, properties) {
                var elem = $("#" + elementId);
                if (properties.hidden) {
                    console.debug("hiding element " + elem.attr("id"));
                    elem.find("input:radio, input:checkbox").removeAttr("checked");
                    elem.hide();
                } else {
                    console.debug("showing element " + elem.attr("id"));
                    elem.removeClass("hidden"); // written server-side to help(?) non-javascript viewers
                    elem.show();
                }
            })
        }
    });
}

// shows hidden Cookies link if JS is enabled
$(document).ready(function() {
    (function () {
      "use strict"
      const cookieFooterLink = document.getElementById("js-cookies-link")
      if(cookieFooterLink)
        cookieFooterLink.hidden = false
    }).call(this);
});

</script>
        <script>function initialiseRequest(reqUrl, totalRunTime, reqDelayInMilliseconds, reqType) {
    var reqAttempts = 0;
    var maxReqAttempts = totalRunTime / reqDelayInMilliseconds;
    function reqFiles() {
        if(reqAttempts >= maxReqAttempts) {
            insertErrorBox('Something went wrong', 'Our service is currently unavailable. Please try again later.');
        } else {
            ajaxReq(reqUrl,
                    reqType,
                    function(){openLink(reqUrl)},
                    function(){setTimeout(function(){reqAttempts += 1; reqFiles();}, reqDelayInMilliseconds)});
        }
    }
    reqFiles();
}

function ajaxReq(reqUrl, reqType, onSuccess, onError) {
    $.ajax({
        crossOrigin: true,
        url: reqUrl,
        type: reqType,
        success: function(result){
                onSuccess();
                },
        error: function (response, status, error) {
                onError();
    }});
}

function openLink(reqUrl) {
    window.location.href = reqUrl;
}</script>
        <script>$(document).ready(function () {
    $("input:checkbox[name^='niceClassificationFilterBy']").change(function(){
        $(":hidden[name='niceClassificationFilterState']").val(this.value);
        $("form").submit();
    });

    setOpenButtonText();
    triggerAriaLive();
    setFilterFocusState();
});

function setFilterFocusState() {
    var $hsf = $(":hidden[name='niceClassificationFilterState']");

    if($hsf.length > 0 && $hsf.val().length > 0) {
        var element = $("input:checkbox[name^='niceClassificationFilterBy'][value=" + $hsf.val() + "]");
        if(element != null) element.focus();
    } else
        $("div[name='searchResults']").focus();
}

function triggerAriaLive() {
    // Trigger aria-live by removing extraneous full stop from heading. This is to ensure that screen readers
    // pick up the changes to the results heading following application or removal of filters.
    var element = $("div[name='searchResults'] h2")[0];
    if(element != null) element.innerText = element.innerText.slice(0, -1);
}

function setOpenButtonText() {
    var element = document.querySelector('.govuk-accordion__open-all');

    if(element != null) {
        var buttonHtml = element.getAttribute('aria-expanded') === 'true' ? 'Close all' : 'Expand all';
        buttonHtml += '<span class="govuk-visually-hidden"> filter options</span>';
        element.innerHTML = buttonHtml;
    }
}

document.addEventListener("DOMContentLoaded", function () {
    setOpenButtonText();
    var accordion = document.querySelector('.govuk-accordion');
    if(accordion != null) accordion.addEventListener("click", setOpenButtonText);
});</script>
