@media screen and (min-width: 1020px){
.alertbar { 
    background-color: white; 
    color: red; 
    display: block; 
    line-height: 2;
    height: 40px; 
    position: relative; 
    font-family: 'Average Sans', sans-serif;
    font-size: 18px;
    text-align: center; 
    text-decoration: none; 
    top: 0px; 
    width: 100%;
    z-index: 100;
}
.alertbar a{
    color: blue;
    font-size: 18px;
}
.alertbar a:hover{
    text-decoration: underline
}
}
@media screen and (min-width: 850px) and (max-width: 1019px){
.alertbar { 
    align-items: center;
    background-color: white; 
    color: red; 
    display: block;
    font-family: 'Average Sans', sans-serif;
    font-size: 14px;
    height: 20px;
    justify-content: center;
    position: relative; 
    text-align: center; 
    text-decoration: none; 
    top: 0px; 
    width: 100%;
    z-index: 100;
}
.alertbar a{
    color: blue;
    font-size: 14px;
}
.alertbar a:hover{
    text-decoration: underline
}
}
