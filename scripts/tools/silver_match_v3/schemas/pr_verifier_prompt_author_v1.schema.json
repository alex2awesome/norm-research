{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_name",
    "prompt_text",
    "parse_rule",
    "selection_rule",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "silver-match-v3-pr-verifier-fresh-author-v1"
    },
    "prompt_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "prompt_text": {
      "type": "string",
      "minLength": 900,
      "maxLength": 14000
    },
    "parse_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_decisions",
        "confirm_metric_id_is_proposal",
        "better_candidate_metric_id_is_supplied_alternative",
        "other_decisions_metric_id_null",
        "confidence_values",
        "confirm_requires_explicit_criterion",
        "confirm_requires_exact_leaf_contrast",
        "reason_max_words"
      ],
      "properties": {
        "allowed_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CONFIRM_MATCH",
              "AMBIGUOUS_MATCH",
              "BETTER_CANDIDATE",
              "NO_EXPLICIT_CRITERION",
              "CONTEXT_NEEDED",
              "GENERIC_VERDICT",
              "NO_CANDIDATE_FITS",
              "NOISE"
            ]
          },
          "minItems": 8,
          "maxItems": 8
        },
        "confirm_metric_id_is_proposal": {"type": "boolean", "const": true},
        "better_candidate_metric_id_is_supplied_alternative": {"type": "boolean", "const": true},
        "other_decisions_metric_id_null": {"type": "boolean", "const": true},
        "confidence_values": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "minItems": 3,
          "maxItems": 3
        },
        "confirm_requires_explicit_criterion": {"type": "boolean", "const": true},
        "confirm_requires_exact_leaf_contrast": {"type": "boolean", "const": true},
        "reason_max_words": {"type": "integer", "const": 24}
      }
    },
    "selection_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_count",
        "choose_without_verifier_dev_truth",
        "optimize_only_authoring",
        "promotion_requires_frozen_fresh_dev_gates",
        "precision_dominates_yield",
        "no_candidate_fits_route"
      ],
      "properties": {
        "variant_count": {"type": "integer", "const": 1},
        "choose_without_verifier_dev_truth": {"type": "boolean", "const": true},
        "optimize_only_authoring": {"type": "boolean", "const": true},
        "promotion_requires_frozen_fresh_dev_gates": {"type": "boolean", "const": true},
        "precision_dominates_yield": {"type": "boolean", "const": true},
        "no_candidate_fits_route": {"type": "string", "const": "full_bank_rescue"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used_only_inline_identity_stripped_optimize_evidence",
        "tools_called",
        "verifier_dev_truth_read",
        "select_test_or_blind_material_read",
        "mi_or_outcomes_read",
        "training_packet_report_sha256",
        "training_examples_sha256",
        "sanitized_evidence_sha256",
        "input_freeze_sha256"
      ],
      "properties": {
        "used_only_inline_identity_stripped_optimize_evidence": {"type": "boolean", "const": true},
        "tools_called": {"type": "boolean", "const": false},
        "verifier_dev_truth_read": {"type": "boolean", "const": false},
        "select_test_or_blind_material_read": {"type": "boolean", "const": false},
        "mi_or_outcomes_read": {"type": "boolean", "const": false},
        "training_packet_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "training_examples_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sanitized_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_freeze_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
