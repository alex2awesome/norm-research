{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_name",
    "prompt_text",
    "parse_rule",
    "selection_rule",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "silver-match-v3-pr-r4-fresh-author-v1"
    },
    "prompt_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "prompt_text": {
      "type": "string",
      "minLength": 500,
      "maxLength": 12000
    },
    "parse_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_decisions",
        "match_requires_evidence_span",
        "match_requires_exact_leaf_contrast",
        "nonmatch_metric_id_must_be_null",
        "reason_max_words"
      ],
      "properties": {
        "allowed_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "MATCH",
              "MATCH_FAMILY_ONLY",
              "NO_CANDIDATE_FITS",
              "NO_EXPLICIT_CRITERION",
              "GENERIC_VERDICT",
              "CONTEXT_NEEDED",
              "NOISE"
            ]
          },
          "minItems": 7,
          "maxItems": 7
        },
        "match_requires_evidence_span": {"type": "boolean", "const": true},
        "match_requires_exact_leaf_contrast": {"type": "boolean", "const": true},
        "nonmatch_metric_id_must_be_null": {"type": "boolean", "const": true},
        "reason_max_words": {"type": "integer", "minimum": 12, "maximum": 32}
      }
    },
    "selection_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_count",
        "choose_without_select_scores",
        "optimize_only_authoring",
        "promotion_requires_frozen_gates",
        "retriever_miss_route"
      ],
      "properties": {
        "variant_count": {"type": "integer", "const": 1},
        "choose_without_select_scores": {"type": "boolean", "const": true},
        "optimize_only_authoring": {"type": "boolean", "const": true},
        "promotion_requires_frozen_gates": {"type": "boolean", "const": true},
        "retriever_miss_route": {"type": "string", "const": "full_bank_rescue"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used_only_frozen_handoff",
        "select_material_read",
        "select_scores_read",
        "mi_or_outcomes_read",
        "handoff_freeze_sha256",
        "gradient_errors_sha256",
        "retriever_misses_sha256",
        "r3_score_sha256"
      ],
      "properties": {
        "used_only_frozen_handoff": {"type": "boolean", "const": true},
        "select_material_read": {"type": "boolean", "const": false},
        "select_scores_read": {"type": "boolean", "const": false},
        "mi_or_outcomes_read": {"type": "boolean", "const": false},
        "handoff_freeze_sha256": {"type": "string", "const": "3daf7f9e897010e2f7520ee4fc2d01e1be2adb7388c9240a945bbb20b03516fa"},
        "gradient_errors_sha256": {"type": "string", "const": "0219d48521a2079864f743b414ac4cbe82dd3643b0d413494f934509b8d05c99"},
        "retriever_misses_sha256": {"type": "string", "const": "ddeda0f1d921e51f5fcbba77e31c4071be2a997d9f704bae822e28931d7b0d32"},
        "r3_score_sha256": {"type": "string", "const": "9b0cf8943c2371b16202058206a534672398cd286be555481eebfbee56e26d36"}
      }
    }
  }
}
