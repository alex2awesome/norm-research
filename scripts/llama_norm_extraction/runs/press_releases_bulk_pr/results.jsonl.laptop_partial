{"unit_id": "pair_38220_183758", "ok": true, "issues": [], "snap_stats": {"exact": 19, "ws_normalized": 0, "no_match": 0, "anchor_only": 0, "empty": 0}, "parsed": {"unit_id": "pair_38220_183758", "passages": [{"passage_text": "On the campaign trail, President Trump frequently said America's tax rate was the highest in the world -- and for this group of Americans he wasn't far off the mark.", "passage_polarity": "neutral", "signals": [{"signal_text": "President Trump frequently said America's tax rate was the highest in the world", "signal_type": "observation", "polarity": "neutral", "rubric_matches": [34, 50], "_snap_kind": "exact"}, {"signal_text": "for this group of Americans he wasn't far off the mark", "signal_type": "observation", "polarity": "neutral", "rubric_matches": [29, 32], "_snap_kind": "exact"}], "_snap_kind": "exact"}, {"passage_text": "The income-tax rate for childless single people in America is the eighth highest out of the Organization for Economic Cooperation and Development's (OECD) 35 member countries at 16.9%, the Paris-based organization found .", "passage_polarity": "neutral", "signals": [{"signal_text": "the Paris-based organization found", "signal_type": "observation", "polarity": "neutral", "rubric_matches": [2, 3], "_snap_kind": "exact"}, {"signal_text": "eighth highest out of the Organization for Economic Cooperation and Development's (OECD) 35 member countries", "signal_type": "observation", "polarity": "neutral", "rubric_matches": [67, 116], "_snap_kind": "exact"}], "_snap_kind": "exact"}, {"passage_text": "While that's less than half what the average single person pays in Denmark (35.9%), it is above the OECD average (13.4%).", "passage_polarity": "neutral", "signals": [{"signal_text": "less than half what the average single person pays in Denmark (35.9%)", "signal_type": "observation", "polarity": "neutral", "rubric_matches": [200, 67], "_snap_kind": "exact"}, {"signal_text": "above the OECD average (13.4%)", "signal_type": "observa